// ==================== AUTO LOGIC ====================
function genWrong(correct) {
    const num = parseFloat(correct);
    if (!isNaN(num)) {
        const delta = (Math.random() * 4 + 1) * (Math.random() < 0.5 ? 1 : -1);
        return String(Math.round((num + delta) * 100) / 100);
    }
    const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
    return [...Array(correct.length)].map(() => chars[~~(Math.random() * chars.length)]).join('');
}

function safeClick(el) {
    const inp = el.querySelector('input[type="checkbox"], input[type="radio"]');
    if (inp && !inp.checked) { inp.click(); }
    else if (!inp) { el.click(); }
}

async function auto() {
    if (isRunning) return;
    isRunning = true;
    abortCtrl = new AbortController();
    startBtn.disabled = true;
    stopBtn.disabled = false;
    stopBtn.style.background = '#c92a2a';

    // Bắt đầu bảo vệ 3 phút
    startGuard();

    parseAns();

    const qs = [...document.querySelectorAll('.quiz-item')].filter(q =>
        q.querySelector('.answer-pane')?.dataset.type !== 'QUIZ3'
    );
    const total = qs.length;

    if (total === 0) {
        statusEl.textContent = '⚠️ Không có câu hỏi!';
        isRunning = false;
        startBtn.disabled = false;
        stopBtn.disabled = true;
        stopBtn.style.background = '#888';
        stopGuard();
        return;
    }

    // GOD MODE
    if (GOD_MODE) {
        statusEl.textContent = '⚡ GOD MODE...';
        let processedCount = 0;

        for (let i = 0; i < qs.length; i++) {
            const q = qs[i];
            const ans = ANSWERS[i];
            if (!ans) continue;

            if (Array.isArray(ans)) {
                for (const letter of ans) {
                    for (const fc of q.querySelectorAll('.form-check')) {
                        const lbl = fc.querySelector('label.answer-text');
                        if (lbl && lbl.textContent.trim().startsWith(letter)) { safeClick(fc); break; }
                    }
                }
                processedCount++;
            } else {
                const ansStr = (ans || '').trim();
                if (ansStr.endsWith('.')) {
                    for (const fc of q.querySelectorAll('.form-check')) {
                        const lbl = fc.querySelector('label.answer-text');
                        if (lbl && lbl.textContent.trim().startsWith(ansStr)) { safeClick(fc); processedCount++; break; }
                    }
                } else {
                    const span = q.querySelector('span.fillquiz[contenteditable]');
                    if (span) {
                        span.innerText = ansStr;
                        ['input','blur'].forEach(t => span.dispatchEvent(new Event(t, {bubbles:true})));
                        processedCount++;
                    }
                }
            }
        }

        statusEl.textContent = `⚡ Xong ${processedCount}/${total}!`;
        isRunning = false;
        updateUI();
        startBtn.disabled = false;
        stopBtn.disabled = true;
        stopBtn.style.background = '#888';
        quizItemsCache.items = null;
        return;
    }

    // NORMAL MODE
    const score = +scoreSlider.value || 8;
    const need = Math.round(score / 10 * total);
    const indices = [...Array(total).keys()].sort(() => Math.random() - 0.5).slice(0, need);
    const correctSet = new Set(indices);
    statusEl.textContent = `🎯 ${score}đ (${need}/${total})`;
    let idx = 0;

    try {
        for (let i = 0; i < qs.length; i++) {
            if (abortCtrl.signal.aborted) { statusEl.textContent = `⏹️ Dừng ${i}/${total}`; break; }
            const q = qs[i];
            const ans = ANSWERS[idx++];
            const correct = correctSet.has(i);

            if (Array.isArray(ans)) {
                if (!q.querySelector('input[type="checkbox"]')) continue;
                if (correct) {
                    statusEl.textContent = `${idx}/${total} ✅`;
                    for (const letter of ans) {
                        for (const fc of q.querySelectorAll('.form-check')) {
                            const lbl = fc.querySelector('label.answer-text');
                            if (lbl && lbl.textContent.trim().startsWith(letter)) { safeClick(fc); break; }
                        }
                    }
                } else {
                    if (Math.random() < 0.5) {
                        const chosen = ans[~~(Math.random() * ans.length)];
                        statusEl.textContent = `${idx}/${total} ⚠️`;
                        for (const fc of q.querySelectorAll('.form-check')) {
                            const lbl = fc.querySelector('label.answer-text');
                            if (lbl && lbl.textContent.trim().startsWith(chosen)) { safeClick(fc); break; }
                        }
                    } else { statusEl.textContent = `${idx}/${total} ❌`; }
                }
            } else {
                const ansStr = (ans || '').trim();
                let final = ansStr, isCor = true;
                if (!correct) {
                    if (ansStr.endsWith('.')) {
                        const opts = [...q.querySelectorAll('.form-check label.answer-text')]
                            .map(l => l.textContent.trim()).filter(t => t && /^[A-Z]\./.test(t));
                        const wrong = opts.filter(o => !o.startsWith(ansStr));
                        final = wrong.length ? wrong[~~(Math.random()*wrong.length)] : null;
                        isCor = false;
                    } else { final = genWrong(ansStr); isCor = false; }
                }
                statusEl.textContent = `${idx}/${total} ${isCor ? '✅' : '❌'}`;
                if (final === null) {
                } else if (final.endsWith('.')) {
                    for (const fc of q.querySelectorAll('.form-check')) {
                        const lbl = fc.querySelector('label.answer-text');
                        if (lbl && lbl.textContent.trim().startsWith(final)) { safeClick(fc); break; }
                    }
                } else {
                    const span = q.querySelector('span.fillquiz[contenteditable]');
                    if (span) {
                        span.innerText = final;
                        ['input','blur'].forEach(t => span.dispatchEvent(new Event(t, {bubbles:true})));
                    }
                }
            }

            await new Promise((res, rej) => {
                const t = setTimeout(res, +speedSlider.value);
                abortCtrl.signal.addEventListener('abort', () => { clearTimeout(t); rej(new DOMException('Aborted','AbortError')); });
            });
        }
    } catch(e) {
        if (e.name !== 'AbortError') throw e;
    } finally {
        isRunning = false;
        updateUI();
        startBtn.disabled = false;
        stopBtn.disabled = true;
        stopBtn.style.background = '#888';
        statusEl.textContent = `✅ Xong ${need}/${total}`;
    }
}

startBtn.onclick = () => {
    parseAns();
    if (!ANSWERS.length) { statusEl.textContent = '⚠️ Nhập đáp án!'; return; }
    auto();
};

stopBtn.onclick = () => {
    abortCtrl?.abort();
    stopGuard();
};

// ==================== DRAGGABLE ====================
let isDragging = false, currentX, currentY, initialX, initialY;
const header = document.getElementById('ktHeader');

header.addEventListener('mousedown', dragStart);
header.addEventListener('touchstart', dragStart, { passive: false });

function dragStart(e) {
    if (e.type === 'touchstart') {
        // Only allow drag with 1 finger on header (not 3-finger toggle)
        if (e.touches.length !== 1) return;
        initialX = e.touches[0].clientX - ui.offsetLeft;
        initialY = e.touches[0].clientY - ui.offsetTop;
    } else {
        initialX = e.clientX - ui.offsetLeft;
        initialY = e.clientY - ui.offsetTop;
    }
    if (e.target === header || header.contains(e.target)) isDragging = true;
}

function drag(e) {
    if (!isDragging) return;
    e.preventDefault();
    if (e.type === 'touchmove') {
        if (e.touches.length !== 1) { isDragging = false; return; }
        currentX = e.touches[0].clientX - initialX;
        currentY = e.touches[0].clientY - initialY;
    } else {
        currentX = e.clientX - initialX;
        currentY = e.clientY - initialY;
    }
    ui.style.left = currentX + 'px';
    ui.style.top = currentY + 'px';
    ui.style.right = 'auto';
}

function dragEnd() {
    if (isDragging) {
        initialX = currentX; initialY = currentY;
        const rect = ui.getBoundingClientRect();
        saveConfig({ uiPosition: { left: rect.left, top: rect.top, right: null } });
    }
    isDragging = false;
}

document.addEventListener('mousemove', drag);
document.addEventListener('mouseup', dragEnd);
document.addEventListener('touchmove', drag, { passive: false });
document.addEventListener('touchend', dragEnd);

// ==================== PERIODIC UPDATES ====================
setInterval(updateUI, 3000);

const debouncedUpdate = (() => {
    let timer;
    return () => { if (timer) clearTimeout(timer); timer = setTimeout(updateUI, 500); };
})();

document.addEventListener('change', debouncedUpdate, true);
document.addEventListener('input', debouncedUpdate, true);
setTimeout(updateUI, 1000);

})(); // end init

})();
