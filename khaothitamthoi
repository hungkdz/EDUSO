// ==================== PARSE ANSWERS ====================
const normAns = arr => arr.map(a => {
    if (Array.isArray(a)) return a.map(item => (item.match(/^[A-Z]\./) || [item.trim()])[0]);
    return (a.match(/^[A-Z]\./) || [a.trim()])[0];
});

function parseAns() {
    const raw = answerInput.value.trim();
    if (!raw) { ANSWERS = []; answerCount.textContent = 0; return; }
    try {
        const parsed = JSON.parse(raw);
        ANSWERS = normAns(Array.isArray(parsed) ? parsed : []);
    } catch {
        ANSWERS = normAns(raw.split('\n').map(line => {
            const t = line.trim();
            if (t.startsWith('[')) { try { return JSON.parse(t); } catch { return t; } }
            return t;
        }).filter(x => x));
    }
    answerCount.textContent = ANSWERS.length;
}

