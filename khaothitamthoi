answerFile.onchange = e => {
    const file = e.target.files[0];
    if (!file) return;
    fileNameDisplay.textContent = file.name.length > 10 ? file.name.slice(0, 10) + '...' : file.name;
    const reader = new FileReader();
    reader.onload = ev => {
        try {
            ANSWERS = normAns(JSON.parse(ev.target.result));
            answerInput.value = JSON.stringify(ANSWERS, null, 2);
            answerCount.textContent = ANSWERS.length;
            statusEl.textContent = `✅ ${ANSWERS.length} đáp án`;
        } catch {
            answerInput.value = ev.target.result;
            parseAns();
        }
    };
    reader.readAsText(file);
};

