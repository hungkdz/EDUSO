let guardActive = false;
let guardStartTime = null;
let guardTimerInterval = null;
let warnVisible = false;

function formatTime(secs) {
    const m = Math.floor(secs / 60);
    const s = secs % 60;
    return `${m}:${s.toString().padStart(2, '0')}`;
}

function startGuard() {
    guardActive = true;
    guardStartTime = Date.now();
    if (guardTimerInterval) clearInterval(guardTimerInterval);
    guardTimerInterval = setInterval(() => {
        const elapsed = Math.floor((Date.now() - guardStartTime) / 1000);
        const remaining = GUARD_DURATION - elapsed;
        if (remaining <= 0) {
            guardActive = false;
            clearInterval(guardTimerInterval);
            guardTimerInterval = null;
            hideWarnOverlay();
            return;
        }
        const timerEl = document.getElementById('ktWarnTimerDisplay');
        const barEl = document.getElementById('ktWarnProgressBar');
        if (timerEl) timerEl.textContent = formatTime(remaining);
        if (barEl) barEl.style.width = ((GUARD_DURATION - remaining) / GUARD_DURATION * 100) + '%';
    }, 1000);
}

function stopGuard() {
    guardActive = false;
    if (guardTimerInterval) { clearInterval(guardTimerInterval); guardTimerInterval = null; }
    hideWarnOverlay();
}

function showWarnOverlay() {
    if (warnVisible) return;
    warnVisible = true;
    const elapsed = Math.floor((Date.now() - guardStartTime) / 1000);
    const remaining = Math.max(0, GUARD_DURATION - elapsed);
    const timerEl = document.getElementById('ktWarnTimerDisplay');
    const barEl = document.getElementById('ktWarnProgressBar');
    if (timerEl) timerEl.textContent = formatTime(remaining);
    if (barEl) barEl.style.width = ((GUARD_DURATION - remaining) / GUARD_DURATION * 100) + '%';
    warnOverlay.classList.add('visible');
}

function hideWarnOverlay() {
    warnVisible = false;
    warnOverlay.classList.remove('visible');
}

document.getElementById('ktWarnConfirmBtn').onclick = () => {
    hideWarnOverlay();
    confirmDialog.classList.add('visible');
};
document.getElementById('ktWarnCancelBtn').onclick = () => hideWarnOverlay();
