// ==UserScript==
// @name         KT Support v2.
// @namespace    https://kt-support
// @version      2.0
// @description  
// @author       Nguyen
// @match        https://practice.eduso.vn/*
// @match        https://*.eduso.vn/*/student/exam/detail/*
// @grant        GM_setValue
// @grant        GM_getValue
// @run-at       document-start
// ==/UserScript==

(function() {
'use strict';

// ==================== BYPASS FULLSCREEN ====================
const win = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;

Object.defineProperty(document, 'fullscreenElement', { get: () => document.documentElement, set: () => {}, configurable: true });
Object.defineProperty(document, 'webkitFullscreenElement', { get: () => document.documentElement, set: () => {}, configurable: true });
Object.defineProperty(document, 'mozFullScreenElement', { get: () => document.documentElement, set: () => {}, configurable: true });
Object.defineProperty(document, 'msFullscreenElement', { get: () => document.documentElement, set: () => {}, configurable: true });
Object.defineProperty(document, 'fullscreen', { get: () => true, set: () => {}, configurable: true });
Object.defineProperty(document, 'webkitIsFullScreen', { get: () => true, set: () => {}, configurable: true });
Object.defineProperty(document, 'mozFullScreen', { get: () => true, set: () => {}, configurable: true });
Object.defineProperty(document, 'msFullscreenEnabled', { get: () => true, set: () => {}, configurable: true });
Object.defineProperty(document, 'fullscreenEnabled', { get: () => true, set: () => {}, configurable: true });
Object.defineProperty(document, 'webkitFullscreenEnabled', { get: () => true, set: () => {}, configurable: true });
Object.defineProperty(document, 'hidden', { get: () => false, set: () => {}, configurable: true });
Object.defineProperty(document, 'visibilityState', { get: () => 'visible', set: () => {}, configurable: true });
Object.defineProperty(document, 'webkitVisibilityState', { get: () => 'visible', set: () => {}, configurable: true });

Document.prototype.hasFocus = function() { return true; };
win.document.hasFocus = function() { return true; };

const originalAddEventListener = EventTarget.prototype.addEventListener;
const blockedEvents = new Set([
    'fullscreenchange', 'webkitfullscreenchange', 'mozfullscreenchange', 'msfullscreenchange',
    'fullscreenerror', 'webkitfullscreenerror',
    'visibilitychange', 'webkitvisibilitychange', 'blur', 'focusout', 'beforeunload'
]);

EventTarget.prototype.addEventListener = function(type, listener, options) {
    const lowerType = String(type).toLowerCase();
    if (blockedEvents.has(lowerType)) return;
    return originalAddEventListener.call(this, type, listener, options);
};

const blockFullscreenRequest = () => {};
if (Element.prototype.requestFullscreen) Element.prototype.requestFullscreen = blockFullscreenRequest;
if (Element.prototype.webkitRequestFullscreen) Element.prototype.webkitRequestFullscreen = blockFullscreenRequest;
if (Element.prototype.mozRequestFullScreen) Element.prototype.mozRequestFullScreen = blockFullscreenRequest;
if (Element.prototype.msRequestFullscreen) Element.prototype.msRequestFullscreen = blockFullscreenRequest;
if (Document.prototype.exitFullscreen) Document.prototype.exitFullscreen = () => Promise.resolve();
if (Document.prototype.webkitExitFullscreen) Document.prototype.webkitExitFullscreen = () => Promise.resolve();
if (Document.prototype.mozCancelFullScreen) Document.prototype.mozCancelFullScreen = () => Promise.resolve();
if (Document.prototype.msExitFullscreen) Document.prototype.msExitFullscreen = () => Promise.resolve();

const blockF11 = (e) => {
    if ((e.key === 'F11' || e.keyCode === 122) && e.isTrusted === false) {
        e.preventDefault(); e.stopImmediatePropagation(); e.stopPropagation();
    }
};
document.addEventListener('keydown', blockF11, true);
document.addEventListener('keyup', blockF11, true);

// Bypass copy/paste
const pasteStyle = document.createElement('style');
pasteStyle.id = 'kt-paste-bypass';
pasteStyle.textContent = `html,body,*{-webkit-user-select:text!important;-moz-user-select:text!important;-ms-user-select:text!important;user-select:text!important;}`;
if (document.documentElement) document.documentElement.appendChild(pasteStyle);

const nullifyDocHandlers = () => {
    [document, document.documentElement, document.body, window].forEach(t => {
        if (!t) return;
        t.oncopy = t.oncut = t.onpaste = t.onselectstart = t.oncontextmenu = t.ondragstart = null;
    });
};
nullifyDocHandlers();

const blockPasteTypes = ['copy','cut','paste','contextmenu','selectstart','dragstart'];
function installPasteBlockers(root) {
    blockPasteTypes.forEach(type => {
        root.addEventListener(type, (e) => {
            if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
            e.stopPropagation(); e.cancelBubble = true;
        }, true);
    });
}
installPasteBlockers(window);
installPasteBlockers(document);

const pasteKeyBlock = (e) => {
    const k = e.key?.toLowerCase();
    if ((e.ctrlKey || e.metaKey) && ['c','v','x','a'].includes(k)) {
        if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
        e.stopPropagation(); e.cancelBubble = true;
    }
};
window.addEventListener('keydown', pasteKeyBlock, true);
window.addEventListener('keyup', pasteKeyBlock, true);

function cleanPasteAttrs(el) {
    if (!el || !el.hasAttribute) return;
    ['oncopy','oncut','onpaste','oncontextmenu','onselectstart','ondragstart'].forEach(a => { if (el.hasAttribute(a)) el.removeAttribute(a); });
    try { el.style.userSelect = 'text'; el.style.webkitUserSelect = 'text'; } catch(e) {}
}
function walkAndCleanPaste(root) {
    cleanPasteAttrs(root);
    if (root.querySelectorAll) root.querySelectorAll('*').forEach(cleanPasteAttrs);
}

const pasteObserverMutation = new MutationObserver(muts => {
    for (const m of muts) {
        if (m.type === 'childList') m.addedNodes.forEach(n => walkAndCleanPaste(n));
        else if (m.type === 'attributes') cleanPasteAttrs(m.target);
    }
});
try {
    if (document.documentElement) {
        pasteObserverMutation.observe(document.documentElement, {
            childList: true, subtree: true, attributes: true,
            attributeFilter: ['oncopy','oncut','onpaste','oncontextmenu','onselectstart','ondragstart','style','class']
        });
    }
} catch(e) {}

let pasteCleanTries = 0;
const pasteCleanTimer = setInterval(() => {
    pasteCleanTries++;
    if (document.documentElement) walkAndCleanPaste(document.documentElement);
    nullifyDocHandlers();
    if (!document.getElementById('kt-paste-bypass') && document.documentElement) document.documentElement.appendChild(pasteStyle);
    if (pasteCleanTries >= 10) clearInterval(pasteCleanTimer);
}, 400);

['fullscreenchange','webkitfullscreenchange','visibilitychange','blur','focusout'].forEach(type => {
    const stopEvent = (e) => { e.stopImmediatePropagation(); e.stopPropagation(); e.cancelBubble = true; };
    document.addEventListener(type, stopEvent, true);
    win.addEventListener(type, stopEvent, true);
});

const cleanFullscreenHandlers = () => {
    [win, document, document.documentElement, document.body].forEach(target => {
        if (target) {
            ['onfullscreenchange','onwebkitfullscreenchange','onvisibilitychange','onblur','onfocusout'].forEach(prop => {
                try { if (target[prop]) target[prop] = null; } catch(e) {}
            });
        }
    });
};

const autoClickFullscreenButton = () => {
    const keywords = ['thực hiện','tiếp tục','đồng ý','bắt đầu','ok','continue','start'];
    const buttons = document.querySelectorAll('button, .btn, [role="button"]');
    for (const btn of buttons) {
        const text = btn.innerText?.toLowerCase() || btn.textContent?.toLowerCase() || '';
        if (keywords.some(kw => text.includes(kw))) {
            const parent = btn.closest('.modal, .dialog, .popup, .alert, [role="dialog"]');
            if (parent) {
                const parentText = parent.innerText?.toLowerCase() || '';
                if (parentText.includes('toàn màn hình') || parentText.includes('fullscreen') || parentText.includes('chế độ làm bài')) {
                    setTimeout(() => btn.click(), 100);
                    return true;
                }
            }
        }
    }
    return false;
};

let autoClickAttempts = 0;
const cleanInterval = setInterval(() => {
    cleanFullscreenHandlers();
    if (autoClickAttempts < 20) { autoClickFullscreenButton(); autoClickAttempts++; }
}, 500);
setTimeout(() => clearInterval(cleanInterval), 60000);

const popupObserver = new MutationObserver(() => autoClickFullscreenButton());
if (document.body) {
    popupObserver.observe(document.body, { childList: true, subtree: true });
} else {
    document.addEventListener('DOMContentLoaded', () => {
        popupObserver.observe(document.body, { childList: true, subtree: true });
    });
}

// ==================== URL CHECK ====================
const isValidURL = location.href.includes('/practice/detail/') || location.href.includes('/student/exam/detail/');
if (!isValidURL) return;

const API_URL = 'https://eduso-answers.edusoauto-license.workers.dev/api/answers';

function getPracticeId() {
    let match = location.pathname.match(/\/practice\/detail\/([a-f0-9]+)/i);
    if (!match) match = location.pathname.match(/\/exam\/detail\/([a-f0-9]+)/i);
    return match ? match[1] : null;
}
const PRACTICE_ID = getPracticeId();

// ==================== CONFIG ====================
const CONFIG_KEY = 'ktSupportConfig_v2';
const DEFAULT_CONFIG = {
    speed: 400, targetScore: 8, godMode: false,
    uiPosition: { top: 40, right: 16, left: null },
    minimized: false
};
const hasGM = typeof GM_setValue !== 'undefined' && typeof GM_getValue !== 'undefined';

function saveConfig(updates) {
    try {
        const newConfig = { ...loadConfig(), ...updates };
        hasGM ? GM_setValue(CONFIG_KEY, JSON.stringify(newConfig)) : localStorage.setItem(CONFIG_KEY, JSON.stringify(newConfig));
        return newConfig;
    } catch(e) { return null; }
}

function loadConfig() {
    try {
        let saved = hasGM ? GM_getValue(CONFIG_KEY, null) : localStorage.getItem(CONFIG_KEY);
        if (saved) {
            const parsed = typeof saved === 'string' ? JSON.parse(saved) : saved;
            return { ...DEFAULT_CONFIG, ...parsed };
        }
        return DEFAULT_CONFIG;
    } catch(e) { return DEFAULT_CONFIG; }
}

let config = loadConfig();

// ==================== WAIT FOR DOM ====================
const waitForDOM = () => new Promise(resolve => {
    if (document.body) { resolve(); return; }
    const obs = new MutationObserver(() => { if (document.body) { obs.disconnect(); resolve(); } });
    obs.observe(document.documentElement, { childList: true, subtree: true });
});

