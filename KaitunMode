            await delay(300);
            const homeURL = getHomeURL();
            if (homeURL) {
                window.location.href = homeURL;
            }
            return;
        }

        if (currentScore !== null) {
            console.log(`[AUTO] 🔍 Điểm hiện tại: ${currentScore} - Cần làm lại để đạt ≥ ${cfg.scoreMin}`);
        } else {
            console.log('[AUTO] ⚠️ Không quét được điểm sau', maxRetries, 'lần thử - Tiếp tục làm bài để chắc chắn');
        }

        const answersJSON = sessionStorage.getItem(ANSWER_KEY);
        if (!answersJSON) {
