    function checkCurrentScore() {
        console.log('[AUTO] 🔍 Bắt đầu quét điểm số...');

        try {
            const allText = document.body.innerText;
            const highScoreMatch = allText.match(/Điểm\s+cao\s+nhất:\s*(\d+\.?\d*)/i);

            if (highScoreMatch) {
                const score = parseFloat(highScoreMatch[1]);
                if (!isNaN(score) && score >= 0 && score <= 10) {
                    console.log(`[AUTO] ✅ [Method 1A] Phát hiện điểm cao nhất: ${score}`);
                    return score;
                }
            }

            const lowScoreMatch = allText.match(/Điểm\s+thấp\s+nhất:\s*(\d+\.?\d*)/i);

            if (lowScoreMatch) {
                const score = parseFloat(lowScoreMatch[1]);
                if (!isNaN(score) && score >= 0 && score <= 10) {
                    console.log(`[AUTO] ✅ [Method 1B] Phát hiện điểm thấp nhất: ${score}`);
                    return score;
                }
            }

            const tdElements = Array.from(document.querySelectorAll('td[style*="user-select: text"]'));

            if (tdElements.length >= 4) {
                const scoreText = tdElements[3].textContent.trim();
                const score = parseFloat(scoreText);

                if (!isNaN(score) && score >= 0 && score <= 10) {
                    console.log(`[AUTO] ✅ [Method 2] Phát hiện điểm: ${score}`);
                    return score;
                }
            }

            const allTds = Array.from(document.querySelectorAll('td'));

            for (const td of allTds) {
                const text = td.textContent.trim();
                if (/^\d+\.?\d*$/.test(text)) {
                    const score = parseFloat(text);
                    if (score >= 0 && score <= 10) {
                        console.log(`[AUTO] ✅ [Method 3] Phát hiện điểm: ${score}`);
                        return score;
                    }
                }
            }

            console.log('[AUTO] ⚠️ Không tìm thấy điểm số bằng tất cả các phương pháp');
            return null;

        } catch (e) {
            console.error('[AUTO] ❌ Lỗi khi kiểm tra điểm:', e);
            return null;
        }
    }

    // ================================================
    // AUTO FILL - TÍCH HỢP ĐIỂM MỤC TIÊU
    // targetScore: điểm cần đạt cho bài này
    // Script sẽ tính số câu đúng cần có để đạt điểm đó,
    // rồi điền đúng số câu đó và sai các câu còn lại
    // ================================================
    async function autoFillAnswers(ANSWERS, targetScore, cfg) {
        console.log('[AUTO] ✏️ Bắt đầu điền', ANSWERS.length, 'đáp án | Mục tiêu:', targetScore, 'điểm');

        const questions = document.querySelectorAll('.quiz-item');
        const total = questions.length;
        const instantMode = cfg.instantMode === true;
        const speed = instantMode ? 0 : (cfg.fillSpeed || 120);

        if (instantMode) {
            console.log('[AUTO] ⚡ INSTANT MODE: Điền tất cả cùng lúc');
        } else {
            console.log(`[AUTO] 🕐 Fill speed: ${speed}ms/câu`);
        }

        // Tính số câu đúng cần thiết để đạt targetScore
        // Giả sử mỗi câu có điểm bằng nhau: totalScore = (đúng / total) * 10
        // => đúng = round(targetScore / 10 * total)
        const correctNeeded = Math.round((targetScore / 10) * total);
        console.log(`[AUTO] 🎯 Cần ${correctNeeded}/${total} câu đúng để đạt ${targetScore} điểm`);

        // Tạo mảng index câu sẽ điền đúng (random)
        const allIndices = Array.from({ length: total }, (_, i) => i);
        const correctIndices = new Set(shuffleArray(allIndices).slice(0, correctNeeded));

        let idx = 0;

        for (let i = 0; i < questions.length; i++) {
            const q = questions[i];

            if (q.querySelector('.answer-pane')?.dataset.type === 'QUIZ3') {
                console.log(`[AUTO] ⭕ Bỏ qua câu ${i + 1} (QUIZ3)`);
                continue;
            }

            const ans = ANSWERS[idx];
            const shouldBeCorrect = correctIndices.has(idx);
            idx++;

            if (!ans) {
                console.log(`[AUTO] ⚠️ Câu ${i + 1}: Không có đáp án`);
                continue;
            }

            console.log(`[AUTO] 🔍 Câu ${i + 1}/${total}: Điền ${shouldBeCorrect ? '✅ ĐÚNG' : '❌ SAI'}`);

            let success = false;

            if (Array.isArray(ans)) {
                const isMulti = q.querySelector('input[type="checkbox"]') !== null;
                if (isMulti) {
                    const formChecks = q.querySelectorAll('.form-check');

                    if (shouldBeCorrect) {
                        // Điền đúng các đáp án đúng
                        for (const letter of ans) {
                            for (const fc of formChecks) {
                                const lbl = fc.querySelector('label.answer-text');
                                if (lbl && lbl.textContent.trim().startsWith(letter)) {
                                    safeClick(fc);
                                    success = true;
                                    break;
                                }
                            }
                        }
                    } else {
                        // Điền sai: chọn đáp án đầu tiên không nằm trong ans
                        for (const fc of formChecks) {
                            const lbl = fc.querySelector('label.answer-text');
                            if (lbl) {
                                const lblText = lbl.textContent.trim();
                                const isCorrectChoice = ans.some(a => lblText.startsWith(a));
                                if (!isCorrectChoice) {
                                    safeClick(fc);
                                    success = true;
                                    break;
                                }
                            }
                        }
                    }
                }
            } else {
                const ansStr = (ans || '').trim();

                if (ansStr.endsWith('.')) {
                    // Trắc nghiệm radio
                    const formChecks = q.querySelectorAll('.form-check');

                    if (shouldBeCorrect) {
                        // Chọn đáp án đúng
                        for (const fc of formChecks) {
                            const lbl = fc.querySelector('label.answer-text');
                            if (lbl && lbl.textContent.trim().startsWith(ansStr)) {
                                success = safeClick(fc);
                                break;
                            }
                        }
                    } else {
                        // Chọn đáp án sai (đáp án đầu tiên không phải đáp án đúng)
                        for (const fc of formChecks) {
                            const lbl = fc.querySelector('label.answer-text');
                            if (lbl && !lbl.textContent.trim().startsWith(ansStr)) {
                                success = safeClick(fc);
                                break;
                            }
                        }
                    }
                } else {
                    // Điền từ
                    const span = q.querySelector('span.fillquiz[contenteditable]');
                    if (span) {
                        if (shouldBeCorrect) {
                            span.innerText = ansStr;
                        } else {
                            // Điền sai: thêm ký tự random vào cuối
                            span.innerText = ansStr + '_x';
                        }
                        span.dispatchEvent(new Event('input', { bubbles: true }));
                        span.dispatchEvent(new Event('blur', { bubbles: true }));
                        success = true;
                    }
                }
            }

            if (!success) {
                console.log(`[AUTO] ⚠️ Không thể điền câu ${i + 1}`);
            }

            await delay(speed);
        }

        console.log('[AUTO] ✅ Hoàn thành điền tất cả đáp án');

        await delay(400);
        console.log('[AUTO] 📤 Bắt đầu nộp bài...');

        const submitBtn = document.querySelector('button.btnComplete[onclick*="CompleteExam"]');
        if (submitBtn) {
            submitBtn.click();
            console.log('[AUTO] ✅ Click "Nộp bài"');
            await delay(700);

            await clickConfirmPopup('xác nhận nộp bài lần 1');
            await delay(400);
            await clickConfirmPopup('xác nhận nộp bài lần 2');

            console.log('[AUTO] ✅ Đã nộp bài thành công');
        } else {
            console.error('[AUTO] ❌ Không tìm thấy nút nộp bài');
        }
    }

    // Hàm shuffle mảng Fisher-Yates
    function shuffleArray(arr) {
        const a = [...arr];
        for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
    }

    function safeClick(el) {
        if (!el) return false;
        try {
            el.click();
            return true;
        } catch {
            const input = el.querySelector('input[type="radio"], input[type="checkbox"]');
            if (input) {
                input.checked = true;
                input.dispatchEvent(new Event('change', { bubbles: true }));
                input.dispatchEvent(new Event('click', { bubbles: true }));
                return true;
            }
        }
        return false;
    }

    // ================================================
    // TRANG ĐÁP ÁN: Quét đáp án và quay lại
    // ================================================
    function initReviewPage() {
        detectSchool();
        console.log('[AUTO] 📖 Đang ở trang đáp án - bắt đầu quét');

        setTimeout(() => {
            const answers = scanAnswers();
            console.log('[AUTO] ✅ Đã quét được', answers.length, 'đáp án:', answers);

            sessionStorage.setItem(ANSWER_KEY, JSON.stringify(answers));

            const practiceURL = sessionStorage.getItem('eduso_practice_url');
            if (practiceURL) {
                console.log('[AUTO] 🔙 Quay lại trang làm bài để điền đáp án:', practiceURL);
                sessionStorage.setItem('eduso_auto_fill', 'true');
                window.location.href = practiceURL;
            } else {
                console.error('[AUTO] ❌ Không tìm thấy link trang làm bài đã lưu');
                alert('❌ Lỗi: Không tìm thấy link trang làm bài');
            }
        }, 800);
    }

    function scanAnswers() {
        const answers = [];

        const allElements = document.querySelectorAll('.form-group.pl-3.m-0, fillquiz');

        allElements.forEach(element => {
            if (element.classList.contains('form-group')) {
                const successSpans = element.querySelectorAll('span.text-success');
                if (successSpans.length === 0) return;

                const answerList = [];
                successSpans.forEach(span => {
                    let text = span.textContent.trim();
                    if (!text || text.includes('Không có')) return;

                    if (/^[A-Z][\.\)\s]/i.test(text)) {
                        answerList.push(text.charAt(0).toUpperCase() + ".");
                    }
                });

                if (answerList.length > 0) {
                    answers.push(answerList.length === 1 ? answerList[0] : answerList);
                }
            } else if (element.tagName.toLowerCase() === 'fillquiz') {
                const fillNodes = element.querySelectorAll('i.text-success, span.text-success');
                fillNodes.forEach(el => {
                    let text = el.textContent.trim();
                    if (!text || text.includes('Không có')) return;
                    if (text.includes('|')) text = text.split('|')[0].trim();
                    answers.push(text);
                });
            }
        });

        return answers;
    }

    // ================================================
    // STORAGE & HELPER FUNCTIONS
    // ================================================
    function saveState(state) {
        try {
            GM_setValue(STORAGE_KEY, JSON.stringify(state));
        } catch (e) {
            console.error('[AUTO] ❌ Lỗi lưu state:', e);
        }
    }

    function getState() {
        try {
            const data = GM_getValue(STORAGE_KEY, null);
            return data ? JSON.parse(data) : null;
        } catch (e) {
            return null;
        }
    }

    function clearState() {
        GM_setValue(STORAGE_KEY, null);
        sessionStorage.removeItem('eduso_practice_url');
        sessionStorage.removeItem('eduso_practice_id');
        sessionStorage.removeItem(ANSWER_KEY);
        sessionStorage.removeItem('eduso_auto_fill');
    }

    function delay(ms) {
        return new Promise(r => setTimeout(r, ms));
    }

