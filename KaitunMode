        // Tab switching
        function switchTab(tab) {
            document.getElementById('panelRun').style.display = tab === 'run' ? 'block' : 'none';
            document.getElementById('panelConfig').style.display = tab === 'config' ? 'block' : 'none';

            const tabRunBtn = document.getElementById('tabRun');
            const tabCfgBtn = document.getElementById('tabConfig');

            if (tab === 'run') {
