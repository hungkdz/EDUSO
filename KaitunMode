        const stopBtn = document.getElementById('stopAutoBtn');
        stopBtn.onclick = () => stopAutoProcess();
        stopBtn.onmouseenter = () => stopBtn.style.background = '#ff5252';
        stopBtn.onmouseleave = () => stopBtn.style.background = '#ff6b6b';
    }

    function startAutoProcess() {
        const lessons = scanAllLessons();
        const cfg = getConfig();
        const pending = lessons.filter(l => {
            if (l.type === 'pending') return true;
            // Bài có điểm thấp hơn scoreMin cũng cần làm lại
            if (l.score !== null && l.score < cfg.scoreMin) return true;
            return false;
        });

        if (pending.length === 0) {
            alert('✅ Tất cả bài đã hoàn thành!');
            return;
        }

        // Đánh dấu lại pending cho đúng
        const updatedLessons = lessons.map(l => {
            if (l.score !== null && l.score < cfg.scoreMin) {
                return { ...l, type: 'pending' };
            }
            return l;
        });

        const state = {
            isRunning: true,
            lessons: updatedLessons,
            currentIndex: 0,
            totalCount: updatedLessons.length,
            pendingCount: pending.length,
            doneCount: updatedLessons.length - pending.length,
            school: detectSchool(),
            config: cfg
        };

        saveState(state);

        document.getElementById('startAutoBtn').style.display = 'none';
        document.getElementById('stopAutoBtn').style.display = 'block';
        updateStatusUI(state);

        processNextLesson(state);
    }

    function continueAutoProcess() {
        const state = getState();
        if (!state || !state.isRunning) return;

        document.getElementById('startAutoBtn').style.display = 'none';
        document.getElementById('stopAutoBtn').style.display = 'block';

        const cfg = state.config || getConfig();
        const lessons = scanAllLessons();

        const updatedLessons = lessons.map(l => {
            if (l.score !== null && l.score < cfg.scoreMin) {
                return { ...l, type: 'pending' };
            }
            return l;
        });

        state.lessons = updatedLessons;
        state.doneCount = updatedLessons.filter(l => l.type === 'done').length;
        state.pendingCount = updatedLessons.filter(l => l.type === 'pending').length;

        saveState(state);
        updateStatusUI(state);

        setTimeout(() => {
            processNextLesson(state);
        }, 200);
    }

    function processNextLesson(state) {
        let nextLesson = null;
        let nextIndex = -1;

        for (let i = 0; i < state.lessons.length; i++) {
            if (state.lessons[i].type === 'pending') {
                nextLesson = state.lessons[i];
                nextIndex = i;
                break;
            }
        }

        if (!nextLesson) {
            finishAutoProcess();
            return;
        }

        state.currentIndex = nextIndex;
        state.currentLesson = nextLesson.title;

        // Tính điểm mục tiêu cho bài này
