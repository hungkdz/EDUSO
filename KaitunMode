    async function tryLoadFromCloud(practiceId) {
        try {
            const response = await fetch(`${API_URL}/${practiceId}`);
            const data = await response.json();

            if (response.ok && data.exists && data.answers) {
                console.log('[AUTO] ☁️ Cloud response:', data);
                return normalizeAnswers(data.answers);
            }
        } catch (error) {
            console.error('[AUTO] ❌ Lỗi khi tải Cloud:', error);
        }
        return null;
    }

    function normalizeAnswers(answers) {
        return answers.map(a => {
            if (Array.isArray(a)) {
                return a.map(item => {
                    const match = item.match(/^[A-Z]\./);
                    return match ? match[0] : item.trim();
                });
            }
            const match = (a || '').match(/^[A-Z]\./);
            return match ? match[0] : (a || '').trim();
        });
    }

    function interceptConsoleReady() {
        const originalLog = console.log;
        let hasStarted = false;

        console.log = function(...args) {
            originalLog(...args);

            if (hasStarted) return;

            if (args.some(a => typeof a === 'string' && a.includes('ready!'))) {
                hasStarted = true;
                console.log('[AUTO] ✅ Phát hiện ready!');
                setTimeout(() => {
                    tryGetAnswers();
                }, 200);
