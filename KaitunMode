        // Radio buttons
        const radios = document.querySelectorAll('input[name="answerMethod"]');
        function updateRadioStyles() {
            radios.forEach(r => {
                const lbl = r.closest('label');
                if (r.checked) {
                    lbl.style.background = 'rgba(102,126,234,0.15)';
                    lbl.style.border = '1px solid rgba(102,126,234,0.4)';
                } else {
                    lbl.style.background = 'rgba(255,255,255,0.04)';
                    lbl.style.border = '1px solid rgba(255,255,255,0.08)';
                }
            });
        }
        radios.forEach(r => {
            r.checked = (r.value === loadedCfg.answerMethod);
        });
        updateRadioStyles();
        radios.forEach(r => r.addEventListener('change', updateRadioStyles));

        // Instant mode checkbox
        const instantCheck = document.getElementById('instantModeCheck');
        const sliderWrap = document.getElementById('speedSliderWrap');
        const slider = document.getElementById('speedSlider');
        const speedLabel = document.getElementById('speedLabel');

        instantCheck.checked = loadedCfg.instantMode;
        slider.value = loadedCfg.fillSpeed;
        speedLabel.textContent = loadedCfg.fillSpeed + 'ms';
        sliderWrap.style.opacity = loadedCfg.instantMode ? '0.35' : '1';
        sliderWrap.style.pointerEvents = loadedCfg.instantMode ? 'none' : 'auto';

        instantCheck.addEventListener('change', () => {
            sliderWrap.style.opacity = instantCheck.checked ? '0.35' : '1';
            sliderWrap.style.pointerEvents = instantCheck.checked ? 'none' : 'auto';
        });
        slider.addEventListener('input', () => {
            speedLabel.textContent = slider.value + 'ms';
        });

        // ---- Score inputs ----
        const scoreMinInput = document.getElementById('scoreMinInput');
        const scoreMaxInput = document.getElementById('scoreMaxInput');
        const scoreHint = document.getElementById('scoreHint');

        function updateScoreHint() {
            const min = parseFloat(scoreMinInput.value);
            const max = parseFloat(scoreMaxInput.value);
            const hasError = isNaN(min) || isNaN(max) || min > max || min < 0 || max > 10;

            if (hasError) {
                scoreHint.style.color = '#ff6b6b';
                if (min > max) {
                    scoreHint.textContent = '⚠️ Điểm tối thiểu phải ≤ điểm tối đa';
                } else if (max > 10) {
                    scoreHint.textContent = '⚠️ Điểm tối đa không được vượt quá 10';
                } else if (min < 0) {
                    scoreHint.textContent = '⚠️ Điểm tối thiểu phải ≥ 0';
                } else {
                    scoreHint.textContent = '⚠️ Giá trị không hợp lệ';
                }
            } else if (min === max) {
                scoreHint.style.color = '#51cf66';
                scoreHint.textContent = `✅ Tất cả bài sẽ được làm đạt đúng ${min} điểm`;
            } else {
                scoreHint.style.color = '#ffd93d';
                scoreHint.textContent = `🎲 Mỗi bài sẽ random điểm từ ${min} đến ${max}`;
            }
        }

        scoreMinInput.addEventListener('input', () => {
            // Ràng buộc giá trị
            let val = parseFloat(scoreMinInput.value);
            if (val < 0) scoreMinInput.value = 0;
            if (val > 10) scoreMinInput.value = 10;
            updateScoreHint();
        });
        scoreMaxInput.addEventListener('input', () => {
            let val = parseFloat(scoreMaxInput.value);
            if (val < 0) scoreMaxInput.value = 0;
            if (val > 10) scoreMaxInput.value = 10;
            updateScoreHint();
        });

        // Khởi tạo hint ngay
        updateScoreHint();

        // ---- Save config ----
        document.getElementById('saveConfigBtn').onclick = () => {
            const selectedMethod = [...document.querySelectorAll('input[name="answerMethod"]')].find(r => r.checked)?.value || 'cloud_then_review';
            const rawMin = parseFloat(scoreMinInput.value);
            const rawMax = parseFloat(scoreMaxInput.value);

            // Validate điểm
            if (isNaN(rawMin) || isNaN(rawMax) || rawMin > rawMax || rawMin < 0 || rawMax > 10) {
                const btn = document.getElementById('saveConfigBtn');
                btn.textContent = '❌ Kiểm tra lại điểm số!';
