

(function() {
    'use strict';

    const STORAGE_KEY = 'eduso_auto_state';
    const ANSWER_KEY = 'eduso_current_answers';
    const SCHOOL_KEY = 'eduso_school_slug';
    const API_URL = 'https://eduso-answers.edusoauto-license.workers.dev/api/answers';

    // ============================================
    // PHÁT HIỆN TRƯỜNG HỌC TỰ ĐỘNG
    // ============================================
    function detectSchool() {
        const pathParts = location.pathname.split('/').filter(p => p);

        if (pathParts.length >= 1) {
            const schoolSlug = pathParts[0];
            if (!['practice'].includes(schoolSlug)) {
                sessionStorage.setItem(SCHOOL_KEY, schoolSlug);
                console.log('[AUTO] 🏫 Phát hiện trường:', schoolSlug);
                return schoolSlug;
            }
        }

        const savedSchool = sessionStorage.getItem(SCHOOL_KEY);
        if (savedSchool) {
            console.log('[AUTO] 🏫 Sử dụng trường đã lưu:', savedSchool);
            return savedSchool;
        }

        console.warn('[AUTO] ⚠️ Không phát hiện được trường học');
        return null;
    }

    function getHomeURL() {
        const school = detectSchool();
        if (!school) {
            console.error('[AUTO] ❌ Không xác định được trường - không thể tạo HOME_URL');
            return null;
        }
        return `https://eduso.vn/${school}/student`;
    }

    function getReviewURL(id) {
        const school = detectSchool();
        if (!school) return null;
        return `/practice.eduso.vn/${school}/student/Practice/ReviewLessonExam/${id}`;
    }

    // ============================================
    // CHẠY Ở MỌI TRANG: Nút dừng nổi (nếu đang chạy)
    // ============================================
    createFloatingStopBtn();
    setTimeout(createFloatingStopBtn, 1000);

    // ============================================
    // PHẦN 1: TRANG CHỦ - Quét và bắt đầu
    // ============================================
    if (location.pathname.match(/^\/[^\/]+\/student\/?$/)) {
        initHomePage();
    }

    // ============================================
    // PHẦN 2: TRANG LÀM BÀI - Xử lý 2 trường hợp
    // ============================================
    else if (location.pathname.includes('/practice/detail/')) {
        initPracticePage();
    }

    // ============================================
    // PHẦN 3: TRANG ĐÁP ÁN - Quét đáp án và quay lại
    // ============================================
    else if (location.pathname.includes('/Practice/ReviewLessonExam/')) {
        initReviewPage();
    }

    // ================================================
    // TRANG CHỦ: UI + Quét bài + Bắt đầu tự động
    // ================================================
    function initHomePage() {
        const school = detectSchool();
        if (!school) {
            console.error('[AUTO] ❌ Không thể khởi tạo - không phát hiện được trường');
            return;
        }

        console.log('[AUTO] 🏠 Khởi tạo trang chủ cho trường:', school);
        cleanupSessionFlags();
        createUI();

        const state = getState();
        if (state && state.isRunning) {
            setTimeout(() => {
                continueAutoProcess();
            }, 300);
        }
    }

    function cleanupSessionFlags() {
        sessionStorage.removeItem('eduso_auto_fill');
        sessionStorage.removeItem('eduso_practice_url');
        sessionStorage.removeItem('eduso_practice_id');
        sessionStorage.removeItem(ANSWER_KEY);
        console.log('[AUTO] 🧹 Đã xóa các flag session cũ');
    }

    // ================================================
    // CONFIG SYSTEM - FIX PERSIST
    // ================================================
    const CONFIG_KEY = 'eduso_auto_config_v2'; // đổi key để tránh conflict với phiên cũ

    function getConfig() {
        try {
            const raw = GM_getValue(CONFIG_KEY, null);
            const defaults = {
                answerMethod: 'cloud_then_review',
                instantMode: false,
                fillSpeed: 120,
                scoreMin: 8,
                scoreMax: 10
            };
            if (raw) {
                const parsed = JSON.parse(raw);
                return Object.assign(defaults, parsed);
            }
            return defaults;
        } catch (e) {
            console.error('[AUTO] ❌ Lỗi đọc config:', e);
            return { answerMethod: 'cloud_then_review', instantMode: false, fillSpeed: 120, scoreMin: 8, scoreMax: 10 };
        }
    }

    function saveConfig(cfg) {
        try {
            GM_setValue(CONFIG_KEY, JSON.stringify(cfg));
            console.log('[AUTO] 💾 Config đã lưu:', cfg);
        } catch (e) {
            console.error('[AUTO] ❌ Lỗi lưu config:', e);
        }
    }

    // ================================================
    // HÀM LẤY ĐIỂM MỤC TIÊU CHO BÀI HIỆN TẠI
    // Random trong khoảng [scoreMin, scoreMax]
    // ================================================
    function getTargetScore(cfg) {
        const min = cfg.scoreMin || 8;
        const max = cfg.scoreMax || 10;
        if (min === max) return min;
        // Random số thực 1 chữ số thập phân trong khoảng
        const step = 0.5; // bước nhảy 0.5 điểm
        const steps = Math.floor((max - min) / step);
        const randomStep = Math.floor(Math.random() * (steps + 1));
        const score = min + randomStep * step;
        return Math.min(score, max);
    }

