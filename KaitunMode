(function() {
    'use strict';

    const STORAGE_KEY = 'eduso_auto_state';
    const ANSWER_KEY = 'eduso_current_answers';
    const HOME_URL = 'https://eduso.vn/thcs-chau-can/student';
    const API_URL = 'https://eduso-answers.edusoauto-license.workers.dev/api/answers';

    // ============================================
    // PHẦN 1: TRANG CHỦ - Quét và bắt đầu
    // ============================================
    if (location.href === HOME_URL) {
        initHomePage();
    }

    // ============================================
    // PHẦN 2: TRANG LÀM BÀI - Xử lý 2 trường hợp
    // ============================================
    else if (location.pathname.includes('/practice/detail/')) {
        initPracticePage();
    }

    // ============================================
    // PHẦN 3: TRANG ĐÁP ÁN - Quét đáp án và quay lại
    // ============================================
    else if (location.pathname.includes('/Practice/ReviewLessonExam/')) {
        initReviewPage();
    }

    // ================================================
    // TRANG CHỦ: UI + Quét bài + Bắt đầu tự động
    // ================================================
    function initHomePage() {
        cleanupSessionFlags();
        createUI();

        const state = getState();
        if (state && state.isRunning) {
            setTimeout(() => {
                continueAutoProcess();
            }, 1000);
        }
    }

    function cleanupSessionFlags() {
        sessionStorage.removeItem('eduso_auto_fill');
        sessionStorage.removeItem('eduso_practice_url');
        sessionStorage.removeItem('eduso_practice_id');
        sessionStorage.removeItem(ANSWER_KEY);
        console.log('[AUTO] 🧹 Đã xóa các flag session cũ');
    }

    function createUI() {
        const btn = document.createElement('button');
        btn.id = 'edusoFullAutoBtn';
        btn.innerHTML = '🚀 Tự Động LÀM TOÀN BỘ BÀI';
        btn.style.cssText = `
            position: fixed; top: 20px; right: 20px; z-index: 999999;
            padding: 12px 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; border: none; border-radius: 8px;
            font-weight: bold; cursor: pointer; font-size: 14px;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
            font-family: sans-serif; transition: all 0.3s;
        `;
        btn.onmouseenter = () => btn.style.transform = 'scale(1.05)';
        btn.onmouseleave = () => btn.style.transform = 'scale(1)';
        document.body.appendChild(btn);

        const panel = document.createElement('div');
        panel.id = 'edusoAutoPanel';
        panel.style.cssText = `
            position: fixed; top: 70px; right: 20px; width: 320px;
            background: rgba(10, 10, 30, 0.95); backdrop-filter: blur(10px);
            color: white; padding: 16px; border-radius: 12px;
            z-index: 999998; font-family: sans-serif; display: none;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        `;
        panel.innerHTML = `
            <h3 style="margin: 0 0 12px; color: #667eea;">📊 Trạng Thái Tự Động</h3>
            <div id="autoStatus" style="font-size: 13px; line-height: 1.8;">
                <div>Tổng bài: <span id="totalCount" style="color: #ffd93d; font-weight: bold;">0</span></div>
                <div>Cần làm: <span id="pendingCount" style="color: #ff6b6b; font-weight: bold;">0</span></div>
                <div>Đã hoàn thành: <span id="doneCount" style="color: #51cf66; font-weight: bold;">0</span></div>
                <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.1);">
                    <div style="color: #aaa; font-size: 11px; margin-bottom: 4px;">Đang xử lý:</div>
                    <div id="currentTask" style="color: #ffd93d; font-weight: bold; font-size: 13px;">Chưa bắt đầu</div>
                </div>
            </div>
            <button id="stopAutoBtn" style="
                width: 100%; margin-top: 12px; padding: 10px;
                background: #ff6b6b; color: white; border: none;
                border-radius: 6px; font-weight: bold; cursor: pointer;
                display: none; transition: all 0.3s;
            ">⏸ DỪNG LẠI</button>
        `;
        document.body.appendChild(panel);

        btn.onclick = () => {
            startAutoProcess();
        };

        const stopBtn = document.getElementById('stopAutoBtn');
        stopBtn.onclick = () => {
            stopAutoProcess();
        };
        stopBtn.onmouseenter = () => stopBtn.style.background = '#ff5252';
        stopBtn.onmouseleave = () => stopBtn.style.background = '#ff6b6b';
    }

    function startAutoProcess() {
        const lessons = scanAllLessons();
        const pending = lessons.filter(l => l.type === 'pending');

        if (pending.length === 0) {
            alert('✅ Tất cả bài đã hoàn thành!');
            return;
        }

        const state = {
            isRunning: true,
            lessons: lessons,
            currentIndex: 0,
            totalCount: lessons.length,
            pendingCount: pending.length,
            doneCount: lessons.length - pending.length
        };

        saveState(state);

        const panel = document.getElementById('edusoAutoPanel');
        panel.style.display = 'block';

        document.getElementById('stopAutoBtn').style.display = 'block';
        updateStatusUI(state);

        processNextLesson(state);
    }

    function continueAutoProcess() {
        const state = getState();
        if (!state || !state.isRunning) return;

        const panel = document.getElementById('edusoAutoPanel');
        panel.style.display = 'block';
        document.getElementById('stopAutoBtn').style.display = 'block';

        const lessons = scanAllLessons();
        state.lessons = lessons;
        state.doneCount = lessons.filter(l => l.type === 'done').length;
        state.pendingCount = lessons.filter(l => l.type === 'pending').length;

        saveState(state);
        updateStatusUI(state);

        setTimeout(() => {
            processNextLesson(state);
        }, 500);
    }

    function processNextLesson(state) {
        let nextLesson = null;
        let nextIndex = -1;

        for (let i = 0; i < state.lessons.length; i++) {
            if (state.lessons[i].type === 'pending') {
                nextLesson = state.lessons[i];
                nextIndex = i;
                break;
            }
        }

        if (!nextLesson) {
            finishAutoProcess();
            return;
        }

        state.currentIndex = nextIndex;
        state.currentLesson = nextLesson.title;
        saveState(state);

        document.getElementById('currentTask').textContent = `${nextLesson.title}`;

        console.log(`[AUTO] 🎯 Bắt đầu xử lý bài ${nextIndex + 1}/${state.totalCount}: ${nextLesson.title}`);

        setTimeout(() => {
            const items = document.querySelectorAll('div.flex.cursor-pointer');
            const targetElement = items[nextIndex];
            if (targetElement) {
                targetElement.click();
                console.log(`[AUTO] ✅ Đã click mở bài: ${nextLesson.title}`);
            } else {
                console.error('[AUTO] ❌ Không tìm thấy element bài tập');
            }
        }, 800);
    }

    function scanAllLessons() {
        const items = document.querySelectorAll('div.flex.cursor-pointer');
        const lessons = [];

        items.forEach((el, idx) => {
            const titleEl = el.querySelector('div.text-base');
            const statusEl = el.querySelector('span.text-sm.font-bold');
            if (!titleEl || !statusEl) return;

            const title = titleEl.textContent.trim();
            let statusText = statusEl.textContent.trim();

            let score = null;
            let type = '';

            if (statusText === 'Chưa thực hiện') {
                score = 0;
                type = 'pending';
            } else if (/^\d+\.\d+$/.test(statusText)) {
                score = parseFloat(statusText);
                type = score <= 3.0 ? 'pending' : 'done';
            } else {
                type = 'unknown';
            }

            lessons.push({ index: idx, title, score, type });
        });

        return lessons;
    }

    function updateStatusUI(state) {
        document.getElementById('totalCount').textContent = state.totalCount;
        document.getElementById('pendingCount').textContent = state.pendingCount;
        document.getElementById('doneCount').textContent = state.doneCount;
        if (state.currentLesson) {
            document.getElementById('currentTask').textContent = state.currentLesson;
        }
    }

    function stopAutoProcess() {
        clearState();
        const panel = document.getElementById('edusoAutoPanel');
        panel.style.display = 'none';
        alert('⏸ Đã dừng quá trình tự động');
        location.reload();
    }

    function finishAutoProcess() {
        clearState();
        document.getElementById('currentTask').textContent = '✅ Hoàn thành tất cả!';
        document.getElementById('stopAutoBtn').style.display = 'none';
        setTimeout(() => {
            alert('🎉 Đã hoàn thành tất cả bài tập!');
            location.reload();
        }, 1000);
    }

    // ================================================
    // TRANG LÀM BÀI: 2 TRƯỜNG HỢP + CLOUD API
    // ================================================
    function initPracticePage() {
        console.log('[AUTO] 📝 Đang ở trang làm bài');

        // Lấy Practice ID từ URL
        const practiceId = getPracticeId();
        if (practiceId) {
            sessionStorage.setItem('eduso_practice_id', practiceId);
            console.log('[AUTO] 💾 Practice ID:', practiceId);
        }

        const shouldFillAnswer = sessionStorage.getItem('eduso_auto_fill');

        if (shouldFillAnswer === 'true') {
            console.log('[AUTO] ✏️ CHẾ ĐỘ: Điền đáp án và hoàn thành');
            handleFillAnswersMode();
        } else {
            console.log('[AUTO] 📖 CHẾ ĐỘ: Lấy đáp án');
            const practiceURL = location.href;
            sessionStorage.setItem('eduso_practice_url', practiceURL);
            console.log('[AUTO] 💾 Đã lưu link làm bài:', practiceURL);

            handleGetAnswersMode();
        }
    }

    function getPracticeId() {
        const match = location.pathname.match(/\/practice\/detail\/([a-f0-9]+)/i);
        return match ? match[1] : null;
    }

    // CHẾ ĐỘ 1: LẤY ĐÁP ÁN (ưu tiên Cloud)
    async function handleGetAnswersMode() {
        const practiceId = sessionStorage.getItem('eduso_practice_id');

        if (practiceId) {
            console.log('[AUTO] ☁️ Kiểm tra Cloud API cho Practice ID:', practiceId);
            const cloudAnswers = await tryLoadFromCloud(practiceId);

            if (cloudAnswers && cloudAnswers.length > 0) {
                console.log('[AUTO] ✅ Đã tải được', cloudAnswers.length, 'đáp án từ Cloud!');
                sessionStorage.setItem(ANSWER_KEY, JSON.stringify(cloudAnswers));
                
                // Chuyển sang chế độ điền đáp án ngay
                sessionStorage.setItem('eduso_auto_fill', 'true');
                
                console.log('[AUTO] 🔄 Reload trang để điền đáp án từ Cloud...');
                await delay(800);
                location.reload();
                return;
            } else {
                console.log('[AUTO] ⚠️ Cloud không có đáp án - chuyển sang method cũ');
            }
        }

        // Fallback: Method cũ (unlock đáp án)
        interceptConsoleReady();
    }

    async function tryLoadFromCloud(practiceId) {
        try {
            const response = await fetch(`${API_URL}/${practiceId}`);
            const data = await response.json();

            if (response.ok && data.exists && data.answers) {
                console.log('[AUTO] ☁️ Cloud response:', data);
                return normalizeAnswers(data.answers);
            }
        } catch (error) {
            console.error('[AUTO] ❌ Lỗi khi tải Cloud:', error);
        }
        return null;
    }

    function normalizeAnswers(answers) {
        return answers.map(a => {
            if (Array.isArray(a)) {
                return a.map(item => {
                    const match = item.match(/^[A-Z]\./);
                    return match ? match[0] : item.trim();
                });
            }
            const match = (a || '').match(/^[A-Z]\./);
            return match ? match[0] : (a || '').trim();
        });
    }

    function interceptConsoleReady() {
        const originalLog = console.log;
        let hasStarted = false;

        console.log = function(...args) {
            originalLog(...args);

            if (hasStarted) return;

            if (args.some(a => typeof a === 'string' && a.includes('ready!'))) {
                hasStarted = true;
                console.log('[AUTO] ✅ Phát hiện ready!');

                setTimeout(() => {
                    tryGetAnswers();
                }, 800);
            }
        };

        setTimeout(() => {
            if (!hasStarted) {
                hasStarted = true;
                console.log('[AUTO] ⏰ Timeout - bắt đầu xử lý');
                tryGetAnswers();
            }
        }, 5000);
    }

    async function tryGetAnswers() {
        const answerBtn = findAnswerButton();

        if (answerBtn) {
            console.log('[AUTO] ✅ Tìm thấy "Xem đáp án" - click ngay');
            clickAnswerButton(answerBtn);
        } else {
            console.log('[AUTO] ⚠️ Không có "Xem đáp án" - thực hiện quy trình làm bài để mở khóa');
            await performExamFlowToUnlock();
        }
    }

    function findAnswerButton() {
        return Array.from(document.querySelectorAll('div, button, a, span, li'))
            .find(el => el.textContent?.trim() === 'Xem đáp án');
    }

    function clickAnswerButton(btn) {
        const onclick = btn.getAttribute('onclick') || '';
        const match = onclick.match(/Review\('([^']+)'\)/);

        if (match) {
            const id = match[1];
            const reviewURL = `/thcs-chau-can/student/Practice/ReviewLessonExam/${id}`;
            console.log('[AUTO] 🔀 Redirect đến trang đáp án:', reviewURL);
            window.location.href = reviewURL;
        } else {
            btn.click();
            console.log('[AUTO] 🔀 Click nút "Xem đáp án"');
        }
    }

    async function performExamFlowToUnlock() {
        console.log('[AUTO] 🎯 Bắt đầu quy trình làm bài để mở đáp án');

        const chk = document.getElementById('chkUsage');
        if (chk && !chk.checked) {
            chk.checked = true;
            chk.dispatchEvent(new Event('change', { bubbles: true }));
            if (typeof toggleDoButton === 'function') toggleDoButton();
            console.log('[AUTO] ✅ Đã tick checkbox');
            await delay(300);
        }

        const btn1 = document.getElementById('btn-doExam');
        if (btn1 && !btn1.disabled) {
            btn1.click();
            console.log('[AUTO] ✅ Click "Làm bài" lần 1');
            await delay(800);
        }

        const btn2 = Array.from(document.querySelectorAll('a[onclick*="doExamCode"]'))
            .find(el => el.textContent?.trim() === 'Làm bài');
        if (btn2) {
            btn2.click();
            console.log('[AUTO] ✅ Click "Làm bài" lần 2');
            await delay(1000);
        }

        const submitBtn = document.querySelector('button.btnComplete[onclick*="CompleteExam"]');
        if (submitBtn) {
            submitBtn.click();
            console.log('[AUTO] ✅ Click "Nộp bài"');
            await delay(1200);
        }

        await clickConfirmPopup('xác nhận lần 1');
        await delay(700);
        await clickConfirmPopup('xác nhận lần 2');

        console.log('[AUTO] ✅ Hoàn thành quy trình - chờ chuyển đến đáp án');
    }

    async function clickConfirmPopup(label) {
        for (let i = 0; i < 10; i++) {
            const btn = document.querySelector('.swal2-container .swal2-confirm');
            if (btn) {
                await delay(250);
                btn.click();
                console.log(`[AUTO] ✅ Click ${label}`);
                return true;
            }
            await delay(300);
        }
        console.log(`[AUTO] ⭕ Không thấy ${label}`);
        return false;
    }

    // CHẾ ĐỘ 2: ĐIỀN ĐÁP ÁN VÀ HOÀN THÀNH
    async function handleFillAnswersMode() {
        console.log('[AUTO] 🔄 Chờ trang sẵn sàng để điền đáp án...');

        await delay(3000);

        let currentScore = null;
        let retryCount = 0;
        const maxRetries = 5;
        
        console.log('[AUTO] 🔍 Bắt đầu quét điểm số với retry mechanism...');
        
        while (retryCount < maxRetries && currentScore === null) {
            currentScore = checkCurrentScore();
            
            if (currentScore === null) {
                console.log(`[AUTO] ⏳ Chưa tìm thấy điểm, thử lại lần ${retryCount + 1}/${maxRetries}...`);
                await delay(1000);
                retryCount++;
            } else {
                console.log(`[AUTO] ✅ Đã quét được điểm sau ${retryCount + 1} lần thử: ${currentScore}`);
                break;
            }
        }

        if (currentScore !== null && currentScore > 3.0) {
            console.log(`[AUTO] ✅ Bài đã đạt ${currentScore} điểm - Bỏ qua và quay về trang chủ`);

            sessionStorage.removeItem('eduso_auto_fill');
            sessionStorage.removeItem('eduso_practice_url');
            sessionStorage.removeItem('eduso_practice_id');
            sessionStorage.removeItem(ANSWER_KEY);

            await delay(1000);
            window.location.href = HOME_URL;
            return;
        }

        if (currentScore !== null) {
            console.log(`[AUTO] 🔍 Điểm hiện tại: ${currentScore} - Cần làm lại để đạt > 3.0`);
        } else {
            console.log('[AUTO] ⚠️ Không quét được điểm sau', maxRetries, 'lần thử - Tiếp tục làm bài để chắc chắn');
        }

        const answersJSON = sessionStorage.getItem(ANSWER_KEY);
        if (!answersJSON) {
            console.error('[AUTO] ❌ Không tìm thấy đáp án đã lưu!');
            alert('❌ Lỗi: Không tìm thấy đáp án');
            return;
        }

        const ANSWERS = JSON.parse(answersJSON);
        console.log('[AUTO] ✅ Đã load', ANSWERS.length, 'đáp án:', ANSWERS);

        console.log('[AUTO] 🔄 Bắt đầu quy trình làm lại bài...');

        const chk = document.getElementById('chkUsage');
        if (chk && !chk.checked) {
            chk.checked = true;
            chk.dispatchEvent(new Event('change', { bubbles: true }));
            if (typeof toggleDoButton === 'function') toggleDoButton();
            console.log('[AUTO] ✅ Đã tick checkbox');
            await delay(500);
        }

        const btn1 = document.getElementById('btn-doExam');
        if (btn1 && !btn1.disabled) {
            btn1.click();
            console.log('[AUTO] ✅ Click "Làm bài" lần 1');
            await delay(1000);
        }

        const btn2 = Array.from(document.querySelectorAll('a[onclick*="doExamCode"]'))
            .find(el => el.textContent?.trim() === 'Làm bài');
        if (btn2) {
            btn2.click();
            console.log('[AUTO] ✅ Click "Làm bài" lần 2 (popup)');
            await delay(1500);
        }

        await autoFillAnswers(ANSWERS);

        console.log('[AUTO] 🧹 Xóa các flag sau khi hoàn thành bài');
        sessionStorage.removeItem('eduso_auto_fill');
        sessionStorage.removeItem('eduso_practice_url');
        sessionStorage.removeItem('eduso_practice_id');
        sessionStorage.removeItem(ANSWER_KEY);

        console.log('[AUTO] 🏠 Quay về trang chủ để tiếp tục bài tiếp theo...');
        await delay(2000);
        window.location.href = HOME_URL;
    }

    function checkCurrentScore() {
        console.log('[AUTO] 🔍 Bắt đầu quét điểm số...');
        
        try {
            const allText = document.body.innerText;
            const highScoreMatch = allText.match(/Điểm\s+cao\s+nhất:\s*(\d+\.?\d*)/i);
            
            if (highScoreMatch) {
                const score = parseFloat(highScoreMatch[1]);
                if (!isNaN(score) && score >= 0 && score <= 10) {
                    console.log(`[AUTO] ✅ [Method 1A] Phát hiện điểm cao nhất: ${score}`);
                    return score;
                }
            }
            
            const lowScoreMatch = allText.match(/Điểm\s+thấp\s+nhất:\s*(\d+\.?\d*)/i);
            
            if (lowScoreMatch) {
                const score = parseFloat(lowScoreMatch[1]);
                if (!isNaN(score) && score >= 0 && score <= 10) {
                    console.log(`[AUTO] ✅ [Method 1B] Phát hiện điểm thấp nhất: ${score}`);
                    return score;
                }
            }
            
            const tdElements = Array.from(document.querySelectorAll('td[style*="user-select: text"]'));
            
            if (tdElements.length >= 4) {
                const scoreText = tdElements[3].textContent.trim();
                const score = parseFloat(scoreText);
                
                if (!isNaN(score) && score >= 0 && score <= 10) {
                    console.log(`[AUTO] ✅ [Method 2] Phát hiện điểm: ${score}`);
                    return score;
                }
            }
            
            const allTds = Array.from(document.querySelectorAll('td'));
            
            for (const td of allTds) {
                const text = td.textContent.trim();
                if (/^\d+\.?\d*$/.test(text)) {
                    const score = parseFloat(text);
                    if (score >= 0 && score <= 10) {
                        console.log(`[AUTO] ✅ [Method 3] Phát hiện điểm: ${score}`);
                        return score;
                    }
                }
            }
            
            console.log('[AUTO] ⚠️ Không tìm thấy điểm số bằng tất cả các phương pháp');
            return null;
            
        } catch (e) {
            console.error('[AUTO] ❌ Lỗi khi kiểm tra điểm:', e);
            return null;
        }
    }

    async function autoFillAnswers(ANSWERS) {
        console.log('[AUTO] ✏️ Bắt đầu điền', ANSWERS.length, 'đáp án');

        const questions = document.querySelectorAll('.quiz-item');
        const total = questions.length;
        const speed = 400;

        let idx = 0;

        for (let i = 0; i < questions.length; i++) {
            const q = questions[i];

            if (q.querySelector('.answer-pane')?.dataset.type === 'QUIZ3') {
                console.log(`[AUTO] ⭕ Bỏ qua câu ${i + 1} (QUIZ3)`);
                continue;
            }

            const ans = ANSWERS[idx++];
            if (!ans) {
                console.log(`[AUTO] ⚠️ Câu ${i + 1}: Không có đáp án`);
                continue;
            }

            console.log(`[AUTO] 🔍 Câu ${i + 1}/${total}: Điền`, ans);

            let success = false;

            // HỖ TRỢ CHECKBOX (Multiple Choice)
            if (Array.isArray(ans)) {
                const isMulti = q.querySelector('input[type="checkbox"]') !== null;
                
                if (isMulti) {
                    console.log(`[AUTO] ☑️ Câu ${i + 1}: Checkbox với ${ans.length} đáp án`);
                    const formChecks = q.querySelectorAll('.form-check');
                    
                    for (const letter of ans) {
                        for (const fc of formChecks) {
                            const lbl = fc.querySelector('label.answer-text');
                            if (lbl && lbl.textContent.trim().startsWith(letter)) {
                                safeClick(fc);
                                console.log(`[AUTO] ✅ Đã chọn ${letter}`);
                                success = true;
                                break;
                            }
                        }
                    }
                } else {
                    console.log(`[AUTO] ⚠️ Câu ${i + 1}: Array answer nhưng không phải checkbox`);
                }
            }
            // Radio hoặc Fill-in
            else {
                const ansStr = (ans || '').trim();
                
                if (ansStr.endsWith('.')) {
                    // Trắc nghiệm radio
                    for (const fc of q.querySelectorAll('.form-check')) {
                        const lbl = fc.querySelector('label.answer-text');
                        if (lbl && lbl.textContent.trim().startsWith(ansStr)) {
                            success = safeClick(fc);
                            if (success) {
                                console.log(`[AUTO] ✅ Đã chọn ${ansStr}`);
                            }
                            break;
                        }
                    }
                } else {
                    // Điền từ
                    const span = q.querySelector('span.fillquiz[contenteditable]');
                    if (span) {
                        span.innerText = ansStr;
                        span.dispatchEvent(new Event('input', { bubbles: true }));
                        span.dispatchEvent(new Event('blur', { bubbles: true }));
                        success = true;
                        console.log(`[AUTO] ✅ Đã điền text "${ansStr}"`);
                    }
                }
            }

            if (!success) {
                console.log(`[AUTO] ⚠️ Không thể điền câu ${i + 1}`);
            }

            await delay(speed);
        }

        console.log('[AUTO] ✅ Hoàn thành điền tất cả đáp án');

        await delay(1000);
        console.log('[AUTO] 📤 Bắt đầu nộp bài...');

        const submitBtn = document.querySelector('button.btnComplete[onclick*="CompleteExam"]');
        if (submitBtn) {
            submitBtn.click();
            console.log('[AUTO] ✅ Click "Nộp bài"');
            await delay(1200);

            await clickConfirmPopup('xác nhận nộp bài lần 1');
            await delay(700);
            await clickConfirmPopup('xác nhận nộp bài lần 2');

            console.log('[AUTO] ✅ Đã nộp bài thành công');
        } else {
            console.error('[AUTO] ❌ Không tìm thấy nút nộp bài');
        }
    }

    function safeClick(el) {
        if (!el) return false;
        try {
            el.click();
            return true;
        } catch {
            const input = el.querySelector('input[type="radio"], input[type="checkbox"]');
            if (input) {
                input.checked = true;
                input.dispatchEvent(new Event('change', { bubbles: true }));
                input.dispatchEvent(new Event('click', { bubbles: true }));
                return true;
            }
        }
        return false;
    }

    // ================================================
    // TRANG ĐÁP ÁN: Quét đáp án và quay lại
    // ================================================
    function initReviewPage() {
        console.log('[AUTO] 📖 Đang ở trang đáp án - bắt đầu quét');

        setTimeout(() => {
            const answers = scanAnswers();
            console.log('[AUTO] ✅ Đã quét được', answers.length, 'đáp án:', answers);

            sessionStorage.setItem(ANSWER_KEY, JSON.stringify(answers));

            const practiceURL = sessionStorage.getItem('eduso_practice_url');
            if (practiceURL) {
                console.log('[AUTO] 🔙 Quay lại trang làm bài để điền đáp án:', practiceURL);
                sessionStorage.setItem('eduso_auto_fill', 'true');
                window.location.href = practiceURL;
            } else {
                console.error('[AUTO] ❌ Không tìm thấy link trang làm bài đã lưu');
                alert('❌ Lỗi: Không tìm thấy link trang làm bài');
            }
        }, 2000);
    }

    function scanAnswers() {
        const answers = [];
        
        // Quét tất cả các element theo đúng thứ tự DOM
        const allElements = document.querySelectorAll('.form-group.pl-3.m-0, fillquiz');

        allElements.forEach(element => {
            if (element.classList.contains('form-group')) {
                // Câu trắc nghiệm
                const successSpans = element.querySelectorAll('span.text-success');
                if (successSpans.length === 0) return;

                const answerList = [];
                successSpans.forEach(span => {
                    let text = span.textContent.trim();
                    if (!text || text.includes('Không có')) return;

                    if (/^[A-Z][\.\)\s]/i.test(text)) {
                        answerList.push(text.charAt(0).toUpperCase() + ".");
                    }
                });

                if (answerList.length > 0) {
                    // 1 đáp án: string, nhiều đáp án: array
                    answers.push(answerList.length === 1 ? answerList[0] : answerList);
                }
            } else if (element.tagName.toLowerCase() === 'fillquiz') {
                // Câu điền từ
                const fillNodes = element.querySelectorAll('i.text-success, span.text-success');
                fillNodes.forEach(el => {
                    let text = el.textContent.trim();
                    if (!text || text.includes('Không có')) return;
                    if (text.includes('|')) text = text.split('|')[0].trim();
                    answers.push(text);
                });
            }
        });

        return answers;
    }

    // ================================================
    // STORAGE & HELPER FUNCTIONS
    // ================================================
    function saveState(state) {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch (e) {
            console.error('[AUTO] ❌ Lỗi lưu state:', e);
        }
    }

    function getState() {
        try {
            const data = localStorage.getItem(STORAGE_KEY);
            return data ? JSON.parse(data) : null;
        } catch (e) {
            return null;
        }
    }

    function clearState() {
        localStorage.removeItem(STORAGE_KEY);
        sessionStorage.removeItem('eduso_practice_url');
        sessionStorage.removeItem('eduso_practice_id');
        sessionStorage.removeItem(ANSWER_KEY);
        sessionStorage.removeItem('eduso_auto_fill');
    }

    function delay(ms) {
        return new Promise(r => setTimeout(r, ms));
    }

})();
