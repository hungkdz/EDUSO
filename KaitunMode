                answerMethod: selectedMethod,
                instantMode: instantCheck.checked,
                fillSpeed: parseInt(slider.value),
                scoreMin: rawMin,
                scoreMax: rawMax
            };
            saveConfig(newCfg);

            const btn = document.getElementById('saveConfigBtn');
            btn.textContent = '✅ Đã lưu config!';
            btn.style.background = 'linear-gradient(135deg,#51cf66,#2f9e44)';
            setTimeout(() => { btn.textContent = '💾 LƯU CẤU HÌNH'; }, 1800);
