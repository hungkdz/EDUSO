    // CHẾ ĐỘ 2: ĐIỀN ĐÁP ÁN VÀ HOÀN THÀNH
    async function handleFillAnswersMode() {
        console.log('[AUTO] 🔄 Chờ trang sẵn sàng để điền đáp án...');

        await delay(1200);

        // Lấy điểm mục tiêu từ state (đã được set khi processNextLesson)
