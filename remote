    remoteMsgEl.style.display = 'block';

    if (type !== 'admin') {
        if (remoteMsgTimer) clearTimeout(remoteMsgTimer);
        remoteMsgTimer = setTimeout(hideRemoteMsg, 4000);
    }
}

function hideRemoteMsg() {
    remoteMsgEl.style.display = 'none';
    if (remoteMsgTimer) { clearTimeout(remoteMsgTimer); remoteMsgTimer = null; }
}

function escapeHtmlMsg(str) {
    return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ==================== STATE ====================
let ANSWERS = [];
let isRunning = false;
let abortCtrl = null;
let GOD_MODE = config.godMode;
let _speed = config.speed;
let _targetScore = config.targetScore;



// ==================== PARSE / LOAD ANSWERS ====================
const normAns = arr => arr.map(a => {
    if (Array.isArray(a)) return a.map(item => (item.match(/^[A-Z]\./) || [item.trim()])[0]);
    return (a.match(/^[A-Z]\./) || [a.trim()])[0];
});

// Load đáp án từ Cloud (dùng khi nhận lệnh loadCloud từ admin)
async function _loadCloud() {
    if (!PRACTICE_ID) return;
    try {
        const res = await fetch(`${API_URL}/${PRACTICE_ID}`);
        const data = await res.json();
        if (res.ok && data.exists) {
            ANSWERS = normAns(data.answers);
        }
    } catch {}
}

// Auto-tải đáp án khi vào trang nếu có trên Cloud
if (PRACTICE_ID) {
    fetch(`${API_URL}/${PRACTICE_ID}`)
        .then(r => r.json())
        .then(d => { if (d.exists) { ANSWERS = normAns(d.answers); console.log(`[KT] Đã tải sẵn ${ANSWERS.length} đáp án từ Cloud`); } })
        .catch(() => {});
}

// ==================== AUTO LOGIC ====================
function genWrong(correct) {
    const num = parseFloat(correct);
    if (!isNaN(num)) {
        const delta = (Math.random() * 4 + 1) * (Math.random() < 0.5 ? 1 : -1);
        return String(Math.round((num + delta) * 100) / 100);
    }
    const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
    return [...Array(correct.length)].map(() => chars[~~(Math.random() * chars.length)]).join('');
}

function safeClick(el) {
    const inp = el.querySelector('input[type="checkbox"], input[type="radio"]');
    if (inp && !inp.checked) { inp.click(); }
    else if (!inp) { el.click(); }
}

async function auto() {
    if (isRunning) return;
    isRunning = true;
    abortCtrl = new AbortController();

    const qs = [...document.querySelectorAll('.quiz-item')].filter(q =>
        q.querySelector('.answer-pane')?.dataset.type !== 'QUIZ3'
    );
    const total = qs.length;

    if (total === 0) {
        isRunning = false;
        showRemoteMsg('⚠️ Không tìm thấy câu hỏi trên trang!', 'warn');
        return;
    }

    // GOD MODE — điền tất cả ngay lập tức
    if (GOD_MODE) {
        let done = 0;
        for (let i = 0; i < qs.length; i++) {
            const q = qs[i];
            const ans = ANSWERS[i];
            if (!ans) continue;
            if (Array.isArray(ans)) {
                for (const letter of ans) {
                    for (const fc of q.querySelectorAll('.form-check')) {
                        const lbl = fc.querySelector('label.answer-text');
                        if (lbl && lbl.textContent.trim().startsWith(letter)) { safeClick(fc); break; }
                    }
                }
                done++;
            } else {
                const ansStr = (ans || '').trim();
                if (ansStr.endsWith('.')) {
                    for (const fc of q.querySelectorAll('.form-check')) {
                        const lbl = fc.querySelector('label.answer-text');
                        if (lbl && lbl.textContent.trim().startsWith(ansStr)) { safeClick(fc); done++; break; }
                    }
                } else {
                    const span = q.querySelector('span.fillquiz[contenteditable]');
                    if (span) {
                        span.innerText = ansStr;
                        ['input','blur'].forEach(t => span.dispatchEvent(new Event(t, {bubbles:true})));
                        done++;
                    }
                }
            }
        }
        isRunning = false;
        return;    }

    // NORMAL MODE — điền theo tốc độ và điểm mục tiêu
    const score = _targetScore || 8;
    const need  = Math.round(score / 10 * total);
    const indices = [...Array(total).keys()].sort(() => Math.random() - 0.5).slice(0, need);
    const correctSet = new Set(indices);
    let idx = 0;

    try {
        for (let i = 0; i < qs.length; i++) {
            if (abortCtrl.signal.aborted) break;
            const q   = qs[i];
            const ans = ANSWERS[idx++];
            const correct = correctSet.has(i);

            if (Array.isArray(ans)) {
                if (!q.querySelector('input[type="checkbox"]')) continue;
                if (correct) {
                    for (const letter of ans) {
                        for (const fc of q.querySelectorAll('.form-check')) {
                            const lbl = fc.querySelector('label.answer-text');
                            if (lbl && lbl.textContent.trim().startsWith(letter)) { safeClick(fc); break; }
                        }
                    }
                } else if (Math.random() < 0.5) {
                    const chosen = ans[~~(Math.random() * ans.length)];
                    for (const fc of q.querySelectorAll('.form-check')) {
                        const lbl = fc.querySelector('label.answer-text');
                        if (lbl && lbl.textContent.trim().startsWith(chosen)) { safeClick(fc); break; }
                    }
                }
            } else {
                const ansStr = (ans || '').trim();
                let final = ansStr;
                if (!correct) {
                    if (ansStr.endsWith('.')) {
                        const opts = [...q.querySelectorAll('.form-check label.answer-text')]
                            .map(l => l.textContent.trim()).filter(t => t && /^[A-Z]\./.test(t));
                        const wrong = opts.filter(o => !o.startsWith(ansStr));
                        final = wrong.length ? wrong[~~(Math.random() * wrong.length)] : null;
                    } else {
                        final = genWrong(ansStr);
                    }
                }
                if (final !== null) {
                    if (final.endsWith('.')) {
                        for (const fc of q.querySelectorAll('.form-check')) {
                            const lbl = fc.querySelector('label.answer-text');
                            if (lbl && lbl.textContent.trim().startsWith(final)) { safeClick(fc); break; }
                        }
                    } else {
                        const span = q.querySelector('span.fillquiz[contenteditable]');
                        if (span) {
                            span.innerText = final;
                            ['input','blur'].forEach(t => span.dispatchEvent(new Event(t, {bubbles:true})));
                        }
                    }
                }
            }

            await new Promise((res, rej) => {
                const t = setTimeout(res, _speed || 400);
                abortCtrl.signal.addEventListener('abort', () => { clearTimeout(t); rej(new DOMException('Aborted', 'AbortError')); });
            });
        }
    } catch(e) {
        if (e.name !== 'AbortError') throw e;
    } finally {
        isRunning = false;
    }
}

})(); // end init
})();
