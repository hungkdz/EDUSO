// Quét tên người dùng từ DOM (span trong menu sidebar)
function getUserName() {
    // Thử nhiều selector phổ biến của eduso
    const selectors = [
        'aside .menu-bar span[style*="inline-block"]',
        'aside span[style*="inline-block"]',
        '.top-menu a span[style*="inline-block"]',
        'nav span[style*="inline-block"]',
        '#sidebar span[style*="inline-block"]',
        '.menu-bar span',
    ];
    for (const sel of selectors) {
        const el = document.querySelector(sel);
        const txt = el?.innerText?.trim() || el?.textContent?.trim();
        if (txt && txt.length > 1 && txt.length < 60 && !/^\d+$/.test(txt)) return txt;
    }
    // Fallback: tìm span đầu tiên trong aside/nav chứa chữ tiếng Việt
    const spans = document.querySelectorAll('aside span, nav span, header span');
    for (const sp of spans) {
        const t = sp.innerText?.trim();
        if (t && t.length > 2 && t.length < 50 && /[a-zA-ZÀ-ỹ]/.test(t) && !sp.querySelector('*')) return t;
    }
    return null;
}

