// Xử lý lệnh từ admin
function handleRemoteCommand(cmd) {
    console.log('[KT Remote] Nhận lệnh:', cmd);

    switch (cmd.type) {
        case 'godmode':
            GOD_MODE = cmd.payload?.enabled ?? !GOD_MODE;
            saveConfig({ godMode: GOD_MODE });
            break;

        case 'message':
            showRemoteMsg(cmd.payload?.text || '', 'admin');
            break;

        case 'clearMsg':
            hideRemoteMsg();
            break;

        case 'start':
            if (!isRunning && ANSWERS.length) auto();
            break;

        case 'startWithAnswers': {
            if (isRunning) break;
            const rawAns = cmd.payload?.answers;
            if (!rawAns || !rawAns.length) break;
            ANSWERS = normAns(rawAns);
            if (cmd.payload?.speed !== undefined)       { _speed = cmd.payload.speed; saveConfig({ speed: _speed }); }
            if (cmd.payload?.targetScore !== undefined) { _targetScore = cmd.payload.targetScore; saveConfig({ targetScore: _targetScore }); }
            if (cmd.payload?.godMode !== undefined)     { GOD_MODE = cmd.payload.godMode; saveConfig({ godMode: GOD_MODE }); }
            auto();
            break;
        }

        case 'stop':
            abortCtrl?.abort();
            break;

        case 'config':
            if (cmd.payload?.speed !== undefined)       { _speed = cmd.payload.speed; saveConfig({ speed: _speed }); }
            if (cmd.payload?.targetScore !== undefined) { _targetScore = cmd.payload.targetScore; saveConfig({ targetScore: _targetScore }); }
            break;

        case 'loadCloud':
            _loadCloud();
            break;

        case 'copyQA':
            doCopyQA();
            break;

        case 'startCapture':
            if (!_screenStream) initScreenCapture();
            break;

        case 'stopCapture':
            stopScreenCapture();
            break;
    }
}

