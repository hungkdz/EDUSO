// ==================== COPY Q&A (gửi lên server để admin xem) ====================
function buildQAText() {
    let output = `trả lời câu hỏi trên theo định dạng giống thế này ["B.","A.","B.","A.","B.","D.","E."...], nếu là câu dạng trắc nghiệm thì ghi đáp án kèm dấu chấm (ví dụ: A.),câu hỏi dạng điền là câu hỏi không có đáp án được liệt kê sau nó mà tiếp theo sẽ đến luôn câu hỏi tiếp theo, nghĩa là không có đáp án nào xen giữa (ví dụ: Question 1: [xuống dòng] Question 2:) nếu là câu dạng điền thì chỉ ghi đáp án và không thêm gì (ví dụ: Employ), lưu ý chỉ trả lời cho tôi đáp án của các câu theo định dạng tôi gửi và không được nói thêm gì. Những câu có đoạn văn bản và câu trả lời dạng Question... thì đó là câu điền đáp án. Riêng Câu 1 luôn luôn chọn theo hướng tích cực (ví dụ: A. "Tôi đã sẵn sàng luyện tập.")\n\n`;

    const partBoxes = document.querySelectorAll('.part-box');
    if (!partBoxes.length) return null;

    let qNum = 1;
    partBoxes.forEach(partBox => {
        let foundDesc = false;
        const quizWrapper = partBox.querySelector('.quiz-wrapper');
        if (quizWrapper) {
            const wrapperText = Array.from(quizWrapper.childNodes)
                .filter(n => {
                    if (n.nodeType === Node.TEXT_NODE) return n.textContent.trim().length > 50;
                    if (n.nodeType === Node.ELEMENT_NODE && !n.classList.contains('quiz-item') && n.innerText?.trim().length > 100) return true;
                    return false;
                })
                .map(n => n.textContent || n.innerText).join(' ').trim();
            if (wrapperText.length > 100) { output += `[Đoạn văn bản]\n${wrapperText}\n\n`; foundDesc = true; }
        }
        if (!foundDesc) {
            const desc = partBox.querySelector('.part-description');
            if (desc) {
                const t = desc.innerText.trim();
                if (t.length > 50) { output += `[Đoạn văn bản]\n${t}\n\n`; foundDesc = true; }
            }
        }
        partBox.querySelectorAll('.quiz-item').forEach(item => {
            const title = item.querySelector('.quiz-box-header .title')?.innerText.trim();
            if (title) output += `Câu ${qNum}: ${title}\n`;
            const fieldsets = item.querySelectorAll('fieldset');
            if (fieldsets.length > 0) {
                fieldsets.forEach(fs => {
                    const letter = fs.querySelector('label span')?.innerText.trim();
                    const answer = fs.querySelector('label div, label p')?.innerText.trim();
                    if (letter && answer) output += `${letter} ${answer}\n`;
                });
            } else {
                const fillInputs = item.querySelectorAll("span.fillquiz input,.fillquiz-item input,input[data-type='QUIZ'],input.fillquiz");
                if (fillInputs.length > 0) {
                    output += '(Điền đáp án đúng của đoạn văn trên)\n';
                    fillInputs.forEach((inp, idx) => { output += `(Điền từ ${idx+1}) ${inp.getAttribute('data-placeholder')||inp.placeholder||''}\n`; });
                } else {
                    const inp = item.querySelector('input, textarea');
                    if (inp) output += `(Điền đáp án đúng của đoạn văn trên)\n(Điền từ) ${inp.placeholder||''}\n`;
                }
            }
            output += '\n';
            qNum++;
        });
    });
    return output;
}

