    // ==================== FILL LOGIC (improved) ====================
    function safeClick(el) {
        const inp = el.querySelector('input[type="checkbox"], input[type="radio"]');
        if (inp && !inp.checked) inp.click();
        else if (!inp) el.click();
    }

    async function fillQuestion(q, raw, domType) {
        if (raw === undefined || raw === null) return false;

        // Checkbox (array answer)
        if (domType === 'checkbox' && Array.isArray(raw)) {
            const options = getOptions(q);
            let hit = false;
            for (const a of raw) {
                const formatted = formatAnswer(a, 'radio');
                const match = smartMatch(formatted, options);
                if (match) { safeClick(match); hit = true; }
            }
            return hit;
        }

        // Fill-in
        if (domType === 'fill') {
            const span = q.querySelector('span.fillquiz[contenteditable]');
            const inp  = q.querySelector("span.fillquiz input,.fillquiz-item input,input[data-type='QUIZ'],input.fillquiz,input[type='text'],textarea");
            const text = formatAnswer(raw, 'fill');
            if (span) {
                span.innerText = text;
                span.dispatchEvent(new Event('input', { bubbles: true }));
                span.dispatchEvent(new Event('blur',  { bubbles: true }));
                return true;
            }
            if (inp) {
                inp.value = text;
                inp.dispatchEvent(new Event('input',  { bubbles: true }));
                inp.dispatchEvent(new Event('change', { bubbles: true }));
                return true;
            }
            return false;
        }

        // Radio (or unknown)
        const options = getOptions(q);
        const formatted = formatAnswer(raw, domType);
        const match = smartMatch(formatted, options);
        if (match) { safeClick(match); return true; }

        // Fallback: if no match and it looks like a text word, try fill
        const span2 = q.querySelector('span.fillquiz[contenteditable]');
        if (span2 && !/^[A-D]\./.test(String(raw).trim())) {
            span2.innerText = String(raw).trim();
            span2.dispatchEvent(new Event('input', { bubbles: true }));
            span2.dispatchEvent(new Event('blur',  { bubbles: true }));
            return true;
        }

        return false;
    }

    // ==================== WRONG ANSWER GEN ====================
    function genWrong(correct, options) {
        // prefer picking a wrong option from actual DOM options
        if (options && options.length > 0) {
            const corLetter = String(correct).toUpperCase().replace(/\.*$/,'') + '.';
            const wrong = options.filter(o => o.letter !== corLetter);
            if (wrong.length) return { type: 'option', el: wrong[~~(Math.random()*wrong.length)].el };
        }
        const num = parseFloat(correct);
        if (!isNaN(num)) {
            const delta = (Math.random()*4+1)*(Math.random()<0.5?1:-1);
            return { type: 'text', val: String(Math.round((num+delta)*100)/100) };
        }
        const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
        return { type: 'text', val: [...Array(String(correct).length)].map(()=>chars[~~(Math.random()*chars.length)]).join('') };
    }

    // ==================== AUTO RUN ====================
    async function auto() {
        if (isRunning) return;
        isRunning = true;
        abortCtrl = new AbortController();
        startBtn.disabled = true;
        stopBtn.disabled = false;
        startGuard();
        parseAns();

        const qs = [...document.querySelectorAll('.quiz-item')].filter(q => q.querySelector('.answer-pane')?.dataset.type !== 'QUIZ3');
        const total = qs.length;
        const types = detectQuestions();

        if (total === 0) {
            statusEl.textContent = '⚠️ Không có câu hỏi!';
            isRunning = false; startBtn.disabled = false; stopBtn.disabled = true; stopGuard(); return;
        }

        const speed = config.godMode ? 0 : (+speedSlider.value || 400);

        // GOD MODE: fill all instantly
        if (config.godMode) {
            statusEl.textContent = '⚡ GOD MODE...';
            let cnt = 0;
            for (let i = 0; i < qs.length; i++) {
                if (abortCtrl.signal.aborted) break;
                const filled = await fillQuestion(qs[i], ANSWERS[i], types[i] || 'radio');
                if (filled) cnt++;
            }
            statusEl.textContent = `⚡ Xong ${cnt}/${total}!`;
            isRunning = false; updateUI();
            startBtn.disabled = false; stopBtn.disabled = true;
            quizCache.items = null; stopGuard(); return;
        }

        // NORMAL MODE: target score
        const score = +scoreSlider.value || 8;
        const need  = Math.round(score/10*total);
        const correctSet = new Set([...Array(total).keys()].sort(()=>Math.random()-.5).slice(0,need));
        statusEl.textContent = `🎯 ${score}đ (${need}/${total})`;
        let cnt = 0;

        try {
            for (let i = 0; i < qs.length; i++) {
                if (abortCtrl.signal.aborted) { statusEl.textContent = `⏹️ Dừng ${i}/${total}`; break; }

                const q = qs[i];
                const raw = ANSWERS[i];
                const domType = types[i] || 'radio';
                const isCorrect = correctSet.has(i);

                statusEl.textContent = `${i+1}/${total} ${isCorrect?'✅':'❌'}`;

                if (isCorrect) {
                    const ok = await fillQuestion(q, raw, domType);
                    if (ok) cnt++;
                } else {
                    // Wrong: pick a different option
                    if (domType === 'fill') {
                        const s = q.querySelector('span.fillquiz[contenteditable]');
                        const inp2 = q.querySelector("span.fillquiz input,.fillquiz-item input,input[type='text'],textarea");
                        const wrong = genWrong(String(raw||'x'), null);
                        const wrongText = wrong.val || 'x';
                        if (s) { s.innerText = wrongText; ['input','blur'].forEach(t=>s.dispatchEvent(new Event(t,{bubbles:true}))); }
                        else if (inp2) { inp2.value = wrongText; ['input','change'].forEach(t=>inp2.dispatchEvent(new Event(t,{bubbles:true}))); }
                    } else if (domType !== 'checkbox' && Math.random() > 0.3) {
                        const options = getOptions(q);
                        const corLetter = formatAnswer(raw, 'radio');
                        const wrongOpts = options.filter(o => o.letter !== corLetter);
                        if (wrongOpts.length) safeClick(wrongOpts[~~(Math.random()*wrongOpts.length)].el);
                    }
                }

                if (speed > 0) {
                    await new Promise((res, rej) => {
                        const t = setTimeout(res, speed);
                        abortCtrl.signal.addEventListener('abort', ()=>{ clearTimeout(t); rej(new DOMException('Aborted','AbortError')); });
                    });
                }
            }
        } catch(e) { if (e.name !== 'AbortError') throw e; }
        finally {
            isRunning = false; updateUI();
            startBtn.disabled = false; stopBtn.disabled = true;
            statusEl.textContent = `✅ Xong ${cnt}/${total}`;
        }
    }

    startBtn.onclick = () => { parseAns(); if (!ANSWERS.length) { statusEl.textContent = '⚠️ Nhập đáp án!'; return; } auto(); };
    stopBtn.onclick  = () => { abortCtrl?.abort(); stopGuard(); };

    // ==================== DRAGGABLE ====================
    let isDragging = false, initialX, initialY, currentX, currentY;
    const header = document.getElementById('edusoHeader');

    header.addEventListener('mousedown', e => {
        initialX = e.clientX - ui.offsetLeft; initialY = e.clientY - ui.offsetTop;
        if (e.target === header || header.contains(e.target)) isDragging = true;
    });
    document.addEventListener('mousemove', e => {
        if (!isDragging) return; e.preventDefault();
        currentX = e.clientX - initialX; currentY = e.clientY - initialY;
        ui.style.left = currentX+'px'; ui.style.top = currentY+'px'; ui.style.right = 'auto';
    });
    document.addEventListener('mouseup', () => {
        if (isDragging) {
            isDragging = false;
            const rect = ui.getBoundingClientRect();
            saveConfig({ uiPosition: { left: rect.left, top: rect.top, right: null } });
        }
    });

    // Dock drag
    let isDockDragging = false, dockIX, dockIY;
    dock.addEventListener('mousedown', e => { dockIX = e.clientX-dock.offsetLeft; dockIY = e.clientY-dock.offsetTop; isDockDragging = true; });
    document.addEventListener('mousemove', e => {
        if (isDockDragging) { dock.style.left=(e.clientX-dockIX)+'px'; dock.style.top=(e.clientY-dockIY)+'px'; dock.style.right='auto'; }
    });
    document.addEventListener('mouseup', () => {
        if (isDockDragging) { isDockDragging = false; const r=dock.getBoundingClientRect(); saveConfig({dockPosition:{left:r.left,top:r.top,right:null}}); }
    });

    // Touch drag for mobile
    header.addEventListener('touchstart', e => { initialX=e.touches[0].clientX-ui.offsetLeft; initialY=e.touches[0].clientY-ui.offsetTop; isDragging=true; }, {passive:false});
    document.addEventListener('touchmove', e => { if(!isDragging) return; e.preventDefault(); currentX=e.touches[0].clientX-initialX; currentY=e.touches[0].clientY-initialY; ui.style.left=currentX+'px'; ui.style.top=currentY+'px'; ui.style.right='auto'; }, {passive:false});
    document.addEventListener('touchend', () => { if(isDragging){isDragging=false; const r=ui.getBoundingClientRect(); saveConfig({uiPosition:{left:r.left,top:r.top,right:null}});} });

    // ==================== PERIODIC UPDATE ====================
    setInterval(updateUI, 3000);
    const debouncedUpdate = (() => { let t; return ()=>{ if(t) clearTimeout(t); t=setTimeout(updateUI,500); }; })();
    document.addEventListener('change', debouncedUpdate, true);
    document.addEventListener('input', debouncedUpdate, true);
    setTimeout(updateUI, 1000);
}

if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAutoUI);
else initAutoUI();

})();
