    startBtn.disabled = true; stopBtn.disabled = false; stopBtn.style.background = '#ff3300';

    const qs = [...document.querySelectorAll('.quiz-item')], total = qs.length;

    // GOD MODE: chọn tất cả đúng, không delay
    if (GOD_MODE) {
        statusEl.textContent = '⚡ GOD MODE...';
        let processedCount = 0;

        // Tối ưu: không dùng forEach, dùng for loop nhanh hơn
        for (let i = 0; i < qs.length; i++) {
            const q = qs[i];
            if (q.querySelector('.answer-pane')?.dataset.type === 'QUIZ3') continue;

            const ans = ANSWERS[i];
            if (!ans) continue;

            if (Array.isArray(ans)) {
                const isMulti = q.querySelector('input[type="checkbox"]') !== null;
                if (isMulti) {
                    const formChecks = q.querySelectorAll('.form-check');
                    for (const letter of ans) {
                        for (const fc of formChecks) {
                            const lbl = fc.querySelector('label.answer-text');
                            if (lbl && lbl.textContent.trim().startsWith(letter)) {
                                safeClick(fc);
                                break;
                            }
                        }
                    }
                    processedCount++;
                }
            } else {
                const ansStr = (ans || '').trim();
                if (ansStr.endsWith('.')) {
                    const formChecks = q.querySelectorAll('.form-check');
                    for (const fc of formChecks) {
                        const lbl = fc.querySelector('label.answer-text');
                        if (lbl && lbl.textContent.trim().startsWith(ansStr)) {
                            safeClick(fc);
                            processedCount++;
                            break;
                        }
                    }
                } else {
                    const span = q.querySelector('span.fillquiz[contenteditable]');
                    if (span) {
                        span.innerText = ansStr;
                        ['input','blur'].forEach(t => span.dispatchEvent(new Event(t, {bubbles:true})));
                        processedCount++;
                    }
                }
            }
        }

        statusEl.textContent = `⚡ Xong ${processedCount}/${total}!`;
        statusEl.style.color = '#ffd700';
        setTimeout(() => { statusEl.style.color = '#ff66cc'; }, 2000);

        isRunning = false;
        updateUI();
        startBtn.disabled = false;
        stopBtn.disabled = true;
        stopBtn.style.background = '#555';

        // Clear cache sau khi xong
        quizItemsCache.items = null;
        return;
    }

    // Chế độ thường
    const score = +scoreSlider.value || 8, need = Math.round(score / 10 * total);
    const indices = [...Array(total).keys()].sort(() => Math.random() - 0.5).slice(0, need);
    const correctSet = new Set(indices);

    statusEl.textContent = `🎯 ${score}đ (${need}/${total})`;
    let idx = 0;

    try {
        for (let i = 0; i < qs.length; i++) {
            if (abortCtrl.signal.aborted) { statusEl.textContent = `⏹️ Dừng ${i}/${total}`; break; }
            const q = qs[i];
            if (q.querySelector('.answer-pane')?.dataset.type === 'QUIZ3') continue;

            const ans = ANSWERS[idx++];
            const correct = correctSet.has(i);

            if (Array.isArray(ans)) {
                const isMulti = q.querySelector('input[type="checkbox"]') !== null;
                if (!isMulti) continue;

                if (correct) {
                    statusEl.textContent = `${idx}/${total} ✅`;
                    for (const letter of ans) {
                        for (const fc of q.querySelectorAll('.form-check')) {
                            const lbl = fc.querySelector('label.answer-text');
                            if (lbl && lbl.textContent.trim().startsWith(letter)) {
                                safeClick(fc);
                                break;
                            }
                        }
                    }
                } else {
                    const wrongType = Math.random() < 0.5 ? 'partial' : 'skip';
                    if (wrongType === 'partial') {
                        const chosen = ans[~~(Math.random() * ans.length)];
                        statusEl.textContent = `${idx}/${total} ⚠️`;
                        for (const fc of q.querySelectorAll('.form-check')) {
                            const lbl = fc.querySelector('label.answer-text');
                            if (lbl && lbl.textContent.trim().startsWith(chosen)) {
                                safeClick(fc);
                                break;
                            }
                        }
                    } else {
                        statusEl.textContent = `${idx}/${total} ❌`;
                    }
                }
            } else {
                const ansStr = (ans || '').trim();
                let final = ansStr, isCor = true;

                if (!correct) {
                    if (ansStr.endsWith('.')) {
                        const opts = [...q.querySelectorAll('.form-check label.answer-text')]
                            .map(l => l.textContent.trim())
                            .filter(t => t && /^[A-Z]\./.test(t));
                        const wrong = opts.filter(o => !o.startsWith(ansStr));
                        final = wrong.length ? wrong[~~(Math.random()*wrong.length)] : null;
                        isCor = false;
                    } else {
                        final = genWrong(ansStr);
                        isCor = false;
                    }
                }

                statusEl.textContent = `${idx}/${total} ${isCor ? '✅' : '❌'}`;

                if (final === null) {
                } else if (final.endsWith('.')) {
                    for (const fc of q.querySelectorAll('.form-check')) {
                        const lbl = fc.querySelector('label.answer-text');
                        if (lbl && lbl.textContent.trim().startsWith(final)) {
                            safeClick(fc);
                            break;
                        }
                    }
                } else {
                    const span = q.querySelector('span.fillquiz[contenteditable]');
                    if (span) {
                        span.innerText = final;
                        ['input','blur'].forEach(t => span.dispatchEvent(new Event(t, {bubbles:true})));
                    }
                }
            }

            await new Promise((res, rej) => {
                const t = setTimeout(res, +speedSlider.value);
                abortCtrl.signal.addEventListener('abort', () => { clearTimeout(t); rej(new DOMException('Aborted','AbortError')); });
            });
        }
    } catch (e) {
        if (e.name !== 'AbortError') throw e;
    } finally {
        isRunning = false;
        updateUI();
        startBtn.disabled = false;
        stopBtn.disabled = true;
        stopBtn.style.background = '#555';
        statusEl.textContent = `✅ Xong ${need}/${total}`;
    }
};

startBtn.onclick = () => {
    parseAns();
    if (!ANSWERS.length) return statusEl.textContent = '⚠️ Nhập đáp án!';
    auto();
};

stopBtn.onclick = () => abortCtrl?.abort();

// Tối ưu: giảm tần suất update từ 1200ms xuống 2000ms
setInterval(updateUI, 2000);

// Tối ưu: dùng event delegation thay vì lắng nghe từng element
const debouncedUpdate = (() => {
    let timer;
    return () => {
        if (timer) clearTimeout(timer);
        timer = setTimeout(updateUI, 300);
    };
})();

document.addEventListener('change', debouncedUpdate, true);
document.addEventListener('input', debouncedUpdate, true);

// Initial update
setTimeout(updateUI, 800);

})();
