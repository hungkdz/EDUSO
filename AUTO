    // ==================== SMART ANSWER FORMATTING ====================
    /**
     * Converts any AI answer to the correct internal format.
     * Handles cases like "Consider" → fill text, "B" → "B.", "B." → "B.", ["A","C"] → ["A.","C."]
     */
    function formatAnswer(raw, domType) {
        // If it's already an array (checkbox)
        if (Array.isArray(raw)) {
            return raw.map(a => {
                const s = String(a).trim();
                // "A" → "A.", "A." → "A.", "Consider" → "Consider"
                if (/^[A-Da-d]$/.test(s)) return s.toUpperCase() + '.';
                if (/^[A-Da-d]\.$/.test(s)) return s.toUpperCase();
                return s; // text answer in array
            });
        }

        const s = String(raw).trim();

        // Fill-in type: always return raw text, strip any leading letter prefix
        if (domType === 'fill') {
            // Strip "A. text" → "text" only if clearly prefixed
            const prefixMatch = s.match(/^[A-Da-d]\.\s+(.+)$/);
            return prefixMatch ? prefixMatch[1].trim() : s;
        }

        // Radio/checkbox single: detect if it's a letter answer
        // "B" → "B."
        if (/^[A-Da-d]$/.test(s)) return s.toUpperCase() + '.';
        // "B." → "B."
        if (/^[A-Da-d]\.$/.test(s)) return s.toUpperCase();
        // "b." → "B."
        if (/^[A-Da-d]\.$/.test(s.toLowerCase())) return s[0].toUpperCase() + '.';

        // Check if it looks like a word answer (fill-in), even if domType is radio
        // (AI sometimes answers "Consider" when it should be a radio choice)
        // We'll try to match against DOM options first (done in fillAnswer)
        return s;
    }

    // ==================== DOM DETECTION (improved) ====================
    function detectQuestions() {
        return [...document.querySelectorAll('.quiz-item')]
            .filter(q => q.querySelector('.answer-pane')?.dataset.type !== 'QUIZ3')
            .map(q => {
                const hasCheckbox = !!q.querySelector('input[type="checkbox"]');
                const hasRadio    = !!q.querySelector('input[type="radio"]');
                const hasFieldset = !!q.querySelector('fieldset');
                const hasFillSpan = !!q.querySelector('span.fillquiz[contenteditable]');
                const hasFillInput = !!q.querySelector("span.fillquiz input,.fillquiz-item input,input[data-type='QUIZ'],input.fillquiz");
                const hasPlainInput = !!q.querySelector('input[type="text"], textarea');

                if (hasCheckbox) return 'checkbox';
                if (hasFillSpan || hasFillInput) return 'fill';
                if (hasRadio || hasFieldset) return 'radio';
                if (hasPlainInput) return 'fill';
                return 'radio';
            });
    }

    /**
     * Get all option texts for a radio question to help match text answers.
     * Returns [{letter: "A.", text: "Consider", el: element}, ...]
     */
    function getOptions(q) {
        return [...q.querySelectorAll('.form-check')].map(fc => {
            const lbl = fc.querySelector('label.answer-text');
            if (!lbl) return null;
            const full = lbl.textContent.trim();
            const letterMatch = full.match(/^([A-D]\.)\s*(.*)/s);
            if (!letterMatch) return null;
            return { letter: letterMatch[1], text: letterMatch[2].trim().toLowerCase(), el: fc, full };
        }).filter(Boolean);
    }

    /**
     * Smart match: given a raw answer and options, find the best match.
     * Handles "B.", "B", "Consider" (text match), partial match.
     */
    function smartMatch(raw, options) {
        if (!options.length) return null;
        const s = String(raw).trim();

        // Direct letter match: "B." or "B"
        const lNorm = s.toUpperCase().replace(/\.*$/, '') + '.';
        const byLetter = options.find(o => o.letter === lNorm);
        if (byLetter) return byLetter.el;

        // Text match (full): "Consider" → find option whose text === "consider"
        const sLower = s.toLowerCase();
        const byFullText = options.find(o => o.text === sLower);
        if (byFullText) return byFullText.el;

        // Partial text match (answer contains or starts with)
        const byPartial = options.find(o => o.text.startsWith(sLower) || sLower.startsWith(o.text.slice(0, Math.max(5, o.text.length - 3))));
        if (byPartial) return byPartial.el;

        // Fuzzy: check if sLower appears within any option text
        const byContains = options.find(o => o.text.includes(sLower) || sLower.includes(o.text.split(' ')[0]));
        if (byContains) return byContains.el;

        return null;
    }

    // ==================== BUILD Q&A PAYLOAD ====================
    function buildQAPayload() {
        let output = '';
        const partBoxes = document.querySelectorAll('.part-box');
        if (partBoxes.length === 0) return null;

        let qNum = 1;
        partBoxes.forEach(partBox => {
            let foundDesc = false;
            const quizWrapper = partBox.querySelector('.quiz-wrapper');
            if (quizWrapper) {
                const wrapText = Array.from(quizWrapper.childNodes)
                    .filter(node => {
                        if (node.nodeType === Node.TEXT_NODE) return node.textContent.trim().length > 50;
                        if (node.nodeType === Node.ELEMENT_NODE && !node.classList.contains('quiz-item') && node.innerText && node.innerText.trim().length > 100) return true;
                        return false;
                    })
                    .map(node => node.textContent || node.innerText).join(' ').trim();
                if (wrapText.length > 100) { output += '[Đoạn văn bản]\n' + wrapText + '\n\n'; foundDesc = true; }
            }
            if (!foundDesc) {
                const desc = partBox.querySelector('.part-description');
                if (desc) { const dt = desc.innerText.trim(); if (dt.length > 50) { output += '[Đoạn văn bản]\n' + dt + '\n\n'; foundDesc = true; } }
            }
            if (!foundDesc) {
                partBox.querySelectorAll('p').forEach(p => {
                    const pt = p.innerText.trim();
                    if (pt.length > 100 && !p.closest('.quiz-item') && !pt.match(/^Question \d+/) && !pt.match(/^Câu \d+/))
                        output += '[Đoạn văn bản]\n' + pt + '\n\n';
                });
            }

            partBox.querySelectorAll('.quiz-item').forEach(item => {
                const title = item.querySelector('.quiz-box-header .title')?.innerText.trim();
                if (title) output += 'Câu ' + qNum + ': ' + title + '\n';

                const fieldsets = item.querySelectorAll('fieldset');
                if (fieldsets.length > 0) {
                    fieldsets.forEach(fs => {
                        const letter = fs.querySelector('label span')?.innerText.trim();
                        const answer = fs.querySelector('label div, label p')?.innerText.trim();
                        if (letter && answer) output += letter + ' ' + answer + '\n';
                    });
                } else {
                    // Also try .form-check options
                    const formChecks = item.querySelectorAll('.form-check');
                    if (formChecks.length > 0) {
                        formChecks.forEach(fc => {
                            const lbl = fc.querySelector('label.answer-text');
                            if (lbl) output += lbl.textContent.trim() + '\n';
                        });
                    } else {
                        const fillInputs = item.querySelectorAll("span.fillquiz input,.fillquiz-item input,input[data-type='QUIZ'],input.fillquiz");
                        if (fillInputs.length > 0) {
                            output += '(Điền đáp án đúng)\n';
                            fillInputs.forEach((inp, idx) => { output += '(Điền từ '+(idx+1)+') '+(inp.getAttribute('data-placeholder')||inp.placeholder||'')+'\n'; });
                        } else {
                            const cfq = item.querySelector('span.fillquiz[contenteditable]');
                            if (cfq) output += '(Điền đáp án đúng)\n';
                            else {
                                const inp = item.querySelector('input, textarea');
                                if (inp) output += '(Điền đáp án đúng)\n(Điền từ) '+(inp.placeholder||'')+'\n';
                            }
                        }
                    }
                }
                output += '\n';
                qNum++;
            });
        });
        return output.trim() || null;
    }

    // ==================== AI CALL ====================
    function callOpenRouter(userMessage) {
        return new Promise((resolve, reject) => {
            const key = getAIKey();
            if (!key) { reject(new Error('NO_KEY')); return; }
            GM_xmlhttpRequest({
                method: 'POST',
                url: 'https://openrouter.ai/api/v1/chat/completions',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + key,
                    'HTTP-Referer': location.origin,
                    'X-Title': 'Eduso Auto'
                },
                data: JSON.stringify({
                    model: AI_MODEL,
                    max_tokens: 1024,
                    temperature: 0.1,
                    messages: [
                        { role: 'system', content: AI_SYSTEM },
                        { role: 'user', content: userMessage }
                    ]
                }),
                onload(res) {
                    try {
                        const data = JSON.parse(res.responseText);
                        if (data.error) { reject(new Error(data.error.message || 'API Error')); return; }
                        resolve(data.choices?.[0]?.message?.content?.trim() || '');
                    } catch(e) { reject(new Error('Parse error')); }
                },
                onerror() { reject(new Error('Không thể kết nối OpenRouter')); }
            });
        });
    }

    function parseAIResponse(text) {
        let clean = text.replace(/```json|```/g, '').trim();
        try { return JSON.parse(clean); } catch {}
        const m = clean.match(/\[([\s\S]*?)\]/);
        if (m) { try { return JSON.parse('['+m[1]+']'); } catch {} }
        return null;
    }

