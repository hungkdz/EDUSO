// Cache các query selector để tránh query lại nhiều lần
const quizItemsCache = { items: null, timestamp: 0 };
const CACHE_DURATION = 2000; // 2 giây

const getQuizItems = () => {
    const now = Date.now();
    if (!quizItemsCache.items || (now - quizItemsCache.timestamp) > CACHE_DURATION) {
        quizItemsCache.items = document.querySelectorAll('.quiz-item');
        quizItemsCache.timestamp = now;
    }
    return quizItemsCache.items;
};

const countTotal = () => getQuizItems().length;

const countDone = () => {
    const items = getQuizItems();
    let count = 0;

    // Tối ưu: dùng vòng lặp đơn thay vì querySelectorAll nhiều lần
    for (const item of items) {
        if (item.querySelector('input[type="radio"]:checked') ||
            item.querySelector('input[type="checkbox"]:checked')) {
            count++;
            continue;
        }

        const fillquiz = item.querySelector('span.fillquiz[contenteditable]');
        if (fillquiz) {
            const text = fillquiz.innerText.trim();
            if (text && text !== 'Trả lời...') {
                count++;
            }
        }
    }

    return count;
};

