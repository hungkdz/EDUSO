// ==================== STEALTH UNLOCK ====================
const unlockStyle = document.createElement('style');
unlockStyle.textContent = `html,body,*{-webkit-user-select:text!important;-moz-user-select:text!important;-ms-user-select:text!important;user-select:text!important;-webkit-touch-callout:default!important;caret-color:auto!important;}`;
document.documentElement.appendChild(unlockStyle);

const nullifyDocHandlers = () => {
    [document, document.documentElement, document.body, window].forEach(t => {
        if (!t) return;
        t.oncopy = t.oncut = t.onpaste = t.onselectstart = t.oncontextmenu = t.ondragstart = null;
    });
};
nullifyDocHandlers();

const blockTypes = ['copy','cut','paste','contextmenu','selectstart','dragstart'];
function installBlockers(root) {
    blockTypes.forEach(type => {
        root.addEventListener(type, (e) => {
            if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
            e.stopPropagation(); e.cancelBubble = true;
        }, true);
    });
}
installBlockers(window); installBlockers(document);

const keyBlock = (e) => {
    const k = e.key.toLowerCase();
    if (e.ctrlKey || e.metaKey) {
        if (['c','v','x','a'].includes(k)) {
            if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
            e.stopPropagation(); e.cancelBubble = true;
        }
    }
};
window.addEventListener('keydown', keyBlock, true);
window.addEventListener('keypress', keyBlock, true);
window.addEventListener('keyup', keyBlock, true);

function cleanAttrs(el) {
    if (!el || !el.hasAttribute) return;
    ['oncopy','oncut','onpaste','oncontextmenu','onselectstart','ondragstart'].forEach(a => { if (el.hasAttribute(a)) el.removeAttribute(a); });
    try { el.style.userSelect = 'text'; } catch {}
}
function walkAndClean(root) { cleanAttrs(root); if (root.querySelectorAll) root.querySelectorAll('*').forEach(cleanAttrs); }

const unlockObserver = new MutationObserver(muts => {
    for (const m of muts) {
        if (m.type === 'childList') m.addedNodes.forEach(n => { walkAndClean(n); });
        else if (m.type === 'attributes') cleanAttrs(m.target);
    }
});
try { unlockObserver.observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: ['oncopy','oncut','onpaste','oncontextmenu','onselectstart','ondragstart','style','class'] }); } catch {}

let unlockTries = 0;
const unlockTimer = setInterval(() => { unlockTries++; walkAndClean(document.documentElement); nullifyDocHandlers(); if (unlockTries >= 10) clearInterval(unlockTimer); }, 400);

// ==================== MAIN ====================
