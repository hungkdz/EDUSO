const normAns = arr => arr.map(a => {
    if (Array.isArray(a)) {
        return a.map(item => (item.match(/^[A-Z]\./) || [item.trim()])[0]);
    }
    return (a.match(/^[A-Z]\./) || [a.trim()])[0];
});

const parseAns = () => {
    const txt = answerInput.value.trim();
    try {
        ANSWERS = txt.startsWith('[') ? JSON.parse(txt) : txt.split(/[\n,]+/).map(s => s.trim()).filter(Boolean);
        ANSWERS = normAns(ANSWERS);
        badge.textContent = ANSWERS.length;
        statusEl.textContent = `✅ Đã phân tích ${ANSWERS.length} đáp án`;
    } catch (e) { statusEl.textContent = `❌ Lỗi: ${e.message}`; }
};

answerFileInput.onchange = e => {
    const f = e.target.files[0];
    if (!f) return;
    const r = new FileReader();
    r.onload = e => {
        try {
            ANSWERS = normAns(JSON.parse(e.target.result));
            answerInput.value = JSON.stringify(ANSWERS, null, 2);
            badge.textContent = ANSWERS.length;
            statusEl.textContent = `✅ Đã tải ${ANSWERS.length} đáp án`;
        } catch (e) {
