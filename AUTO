const genWrong = s => {
    const ops = [
        () => s.length > 2 ? s.slice(0,-1) : s+'x',
        () => s + ['x','z','_'][~~(Math.random()*3)],
        () => { if (s.length < 2) return s+'x'; const i = ~~(Math.random()*(s.length-1)), a = s.split(''); [a[i],a[i+1]] = [a[i+1],a[i]]; return a.join(''); }
    ];
    return ops[~~(Math.random()*ops.length)]();
};

const safeClick = el => {
    if (!el) return false;
    try {
        el.click();
        return true;
    } catch {
        const input = el.querySelector('input[type="radio"], input[type="checkbox"]');
        if (input) {
            input.checked = true;
            ['change','click'].forEach(t => input.dispatchEvent(new Event(t, {bubbles:true})));
            return true;
        }
    }
    return false;
};

