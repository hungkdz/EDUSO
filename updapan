(function() {
    'use strict';

    const API_URL = 'https://eduso-answers.edusoauto-license.workers.dev/api/answers';

    // Namespace để tránh xung đột với script khác
    const NAMESPACE = 'edusoauto_';
    const MAPPING_KEY = NAMESPACE + 'id_mapping';          // reviewId → practiceId
    const UPLOADED_KEY = NAMESPACE + 'uploaded_practice_ids';

    // ==================== TRANG LÀM BÀI ====================
    if (location.pathname.includes('/practice/detail/')) {
        const match = location.pathname.match(/\/practice\/detail\/([a-f0-9]+)/i);
        if (!match || !match[1]) {
            console.log('[EDUSO AUTO] Cannot extract practiceId from URL');
            return;
        }
        const practiceId = match[1];
        console.log('[EDUSO AUTO] 📝 Practice page - practiceId:', practiceId);

        const originalReview = window.Review;
        window.Review = function(reviewId) {
            if (reviewId && reviewId.length > 10) {
                const mapping = JSON.parse(localStorage.getItem(MAPPING_KEY) || '{}');
                mapping[reviewId] = practiceId;
                localStorage.setItem(MAPPING_KEY, JSON.stringify(mapping));
                console.log('[EDUSO AUTO] 🔗 Mapped:', { practiceId, reviewId });
            }
            if (typeof originalReview === 'function') {
                return originalReview.apply(this, arguments);
            }
        };
        console.log('[EDUSO AUTO] ✅ Hooked Review() function');
    }

    // ==================== TRANG ĐÁP ÁN ====================
    if (location.pathname.includes('/ReviewLessonExam/')) {
        const urlParts = location.pathname.split('/');
        const reviewId = urlParts[urlParts.length - 1];
        if (!reviewId || reviewId.length < 10) {
            console.log('[EDUSO AUTO] Invalid reviewId in URL');
            return;
        }
        console.log('[EDUSO AUTO] 📄 Review page - reviewId:', reviewId);

        const mapping = JSON.parse(localStorage.getItem(MAPPING_KEY) || '{}');
        const practiceId = mapping[reviewId];
        if (!practiceId) {
            console.log('[EDUSO AUTO] ⏭️ Skipped - No practiceId mapped for this reviewId');
            return;
        }
        console.log('[EDUSO AUTO] ✅ Found mapping:', { reviewId, practiceId });

        const uploadedIds = JSON.parse(localStorage.getItem(UPLOADED_KEY) || '[]');
        if (uploadedIds.includes(practiceId)) {
            console.log('[EDUSO AUTO] ⏭️ Skipped - Already uploaded:', practiceId);
            delete mapping[reviewId];
            localStorage.setItem(MAPPING_KEY, JSON.stringify(mapping));
            return;
        }

        function scanAnswers() {
            const answers = [];
            const allElements = document.querySelectorAll('.form-group.pl-3.m-0, fillquiz');

            allElements.forEach(element => {
                // Trắc nghiệm
                if (element.classList.contains('form-group')) {
                    const successSpans = element.querySelectorAll('span.text-success');
                    if (successSpans.length === 0) return;
                    const found = [];
                    successSpans.forEach(span => {
                        let text = span.textContent.trim();
                        if (!text || text.includes('Không có')) return;
                        if (/^[A-Z][\.\)\s]/i.test(text)) {
                            found.push(text.charAt(0).toUpperCase() + ".");
                        }
                    });
                    if (found.length > 0) {
                        answers.push(found.length === 1 ? found[0] : found);
                    }
                }
                // Điền từ
                else if (element.tagName.toLowerCase() === 'fillquiz') {
                    const fillNodes = element.querySelectorAll('i.text-success, span.text-success');
                    fillNodes.forEach(el => {
                        let text = el.textContent.trim();
                        if (!text || text.includes('Không có')) return;
                        if (text.includes('|')) text = text.split('|')[0].trim();
                        answers.push(text);
                    });
                }
            });
            return answers;
        }

        async function uploadAnswers(practiceId, answers) {
            try {
                console.log('[EDUSO AUTO] 📤 Uploading:', { practiceId, answersCount: answers.length });
                const response = await fetch(API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ practiceId, answers })
                });
                const result = await response.json();

                if (response.ok && result.success) {
                    console.log('[EDUSO AUTO] ✅ Upload successful!');
                    console.log('[EDUSO AUTO] 📊 Server response:', result);

                    const uploaded = JSON.parse(localStorage.getItem(UPLOADED_KEY) || '[]');
                    if (!uploaded.includes(practiceId)) {
                        uploaded.push(practiceId);
                        localStorage.setItem(UPLOADED_KEY, JSON.stringify(uploaded));
                    }

                    delete mapping[reviewId];
                    localStorage.setItem(MAPPING_KEY, JSON.stringify(mapping));
                    return true;
                } else {
                    console.error('[EDUSO AUTO] ❌ Upload failed:', result);
                    return false;
                }
            } catch (error) {
                console.error('[EDUSO AUTO] ❌ Upload error:', error);
                return false;
            }
        }

        function autoUpload() {
            const answers = scanAnswers();
            if (answers.length === 0) {
                console.log('[EDUSO AUTO] ⏳ No answers found');
                return;
            }
            console.log('[EDUSO AUTO] 🎯 Found', answers.length, 'answers');
            uploadAnswers(practiceId, answers);
        }

        // Retry logic
        let retryCount = 0;
        const maxRetries = 5;
        console.log('[EDUSO AUTO] ⏳ Waiting for page to load...');

        const checkAndUpload = setInterval(() => {
            const elements = document.querySelectorAll('.form-group.pl-3.m-0, fillquiz');
            if (elements.length > 0) {
                clearInterval(checkAndUpload);
                console.log('[EDUSO AUTO] ✅ Page loaded, scanning answers...');
                setTimeout(autoUpload, 1500);
            } else {
                retryCount++;
                if (retryCount >= maxRetries) {
                    clearInterval(checkAndUpload);
                    console.log('[EDUSO AUTO] ⚠️ Max retries reached');
                }
            }
        }, 1000);
    }
})();
