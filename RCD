(function() {
    'use strict';

    if (!location.pathname.includes('ReviewLessonExam')) return;

    // --- UI chính ---
    const ui = document.createElement('div');
    ui.id = 'edusoRecorderPro';
    ui.style.cssText = `
        position: fixed; right: 16px; top: 40px; width: 260px;
        background: rgba(10,5,20,0.85); backdrop-filter: blur(12px);
        border-radius: 14px; padding: 14px;
        font-family: Segoe UI, sans-serif; color: #e0e0ff;
        box-shadow:
            0 0 0 1px rgba(255,0,255,0.3),
            0 8px 24px rgba(255,0,255,0.2),
            inset 0 0 8px rgba(0,255,255,0.1);
        z-index: 99999;
    `;

    ui.innerHTML = `
        <div id="edusoHeader" style="
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 12px; padding-bottom: 4px;
            border-bottom: 1px solid rgba(100,100,200,0.2);
            cursor: grab; user-select: none;
        ">
            <div style="
                font-weight: 800; font-size: 15px;
                background: linear-gradient(90deg, #ff00ff, #00ffff);
                -webkit-background-clip: text; background-clip: text; color: transparent;
                letter-spacing: -0.4px;
            ">
                EDUSO RECORDER
            </div>
            <button id="minBtn" title="Thu nhỏ" style="
                background: none; border: none; cursor: pointer; padding: 8px;
                color: #aaa; border-radius: 8px; width: 32px; height: 32px;
                display: flex; align-items: center; justify-content: center;
                transition: all 0.2s; box-shadow: 0 0 0 1px rgba(100,100,200,0.3);
            "
            onmouseenter="this.style.color='#00ffff';this.style.boxShadow='0 0 0 1px #00ffff'"
            onmouseleave="this.style.color='#aaa';this.style.boxShadow='0 0 0 1px rgba(100,100,200,0.3)'">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 9l6 6 6-6"></path>
                </svg>
            </button>
        </div>

        <div style="text-align:center;margin-bottom:16px;">
            <div style="
                font-size: 36px; font-weight: bold; color: #00ffff;
                text-shadow: 0 0 8px rgba(0,255,255,0.4);
            " id="count">0</div>
            <div style="font-size: 13px; color: #aaa;">câu hỏi đã quét</div>
        </div>

        <div style="display: flex; gap: 8px; margin-bottom: 14px;">
            <button id="copyBtn" style="
                flex: 1; padding: 10px;
                background: linear-gradient(135deg, #00ffff, #00ccff);
                color: #0a0514; border: none; border-radius: 10px;
                font-weight: 700; font-size: 13px; cursor: pointer;
                transition: all 0.3s;
                box-shadow: 0 4px 12px rgba(0,255,255,0.3);
            "
            onmouseenter="this.style.transform='scale(1.03)';this.style.boxShadow='0 6px 16px rgba(0,255,255,0.5)'"
            onmouseleave="this.style.transform='scale(1)';this.style.boxShadow='0 4px 12px rgba(0,255,255,0.3)'">
                <svg width="14" height="14" style="vertical-align:-2px;margin-right:4px;" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                </svg>COPY
            </button>
            <button id="saveBtn" style="
                flex: 1; padding: 10px;
                background: linear-gradient(135deg, #58a6ff, #0070f3);
                color: white; border: none; border-radius: 10px;
                font-weight: 700; font-size: 13px; cursor: pointer;
                transition: all 0.3s;
                box-shadow: 0 4px 12px rgba(88,166,255,0.3);
            "
            onmouseenter="this.style.transform='scale(1.03)';this.style.boxShadow='0 6px 16px rgba(88,166,255,0.5)'"
            onmouseleave="this.style.transform='scale(1)';this.style.boxShadow='0 4px 12px rgba(88,166,255,0.3)'">
                <svg width="14" height="14" style="vertical-align:-2px;margin-right:4px;" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M12 5v10M5 12h10"></path>
                    <path d="M21 21H7V9h6V3h8v18z"></path>
                </svg>TẢI FILE
            </button>
        </div>

        <div id="status" style="
            font-size: 11px; text-align: center; margin-top: 6px;
            min-height: 16px; color: #00ffff;
        ">🔄 Đang theo dõi trang...</div>
    `;

    document.body.appendChild(ui);

    // --- Dock tròn (ẩn khi UI hiện) ---
    const dock = document.createElement('div');
    dock.id = 'edusoRecorderDock';
    dock.style.cssText = `
        position: fixed; width: 44px; height: 44px; border-radius: 50%;
        background: rgba(20,10,40,0.7);
        color: white; display: none; align-items: center; justify-content: center;
        cursor: grab; z-index: 100000;
        box-shadow:
            0 0 0 1px rgba(255,0,255,0.3),
            0 8px 24px rgba(255,0,255,0.2),
            inset 0 0 8px rgba(0,255,255,0.1);
    `;
    dock.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
        <circle cx="12" cy="12" r="9"/>
        <polygon points="10,8 16,12 10,16"/>
    </svg>`;
    document.body.appendChild(dock);

    // --- Kéo thả ---
    function makeDrag(element) {
        let dragging = false, offsetX = 0, offsetY = 0;

        const start = (e) => {
            if (e.button !== 0 && !e.touches) return;
            if (e.target.closest('#minBtn, input, button, textarea')) return;
            e.preventDefault();
            dragging = true;
            const rect = element.getBoundingClientRect();
            offsetX = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
            offsetY = (e.touches ? e.touches[0].clientY : e.clientY) - rect.top;
            document.body.style.userSelect = 'none';
        };

        const move = (e) => {
            if (!dragging) return;
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            element.style.left = `${clientX - offsetX}px`;
            element.style.top = `${clientY - offsetY}px`;
            element.style.right = 'auto';
        };

        const stop = () => {
            if (dragging) {
                dragging = false;
                document.body.style.userSelect = '';
            }
        };

        element.addEventListener('mousedown', start, { passive: false });
        element.addEventListener('touchstart', start, { passive: false });
        document.addEventListener('mousemove', move, { passive: true });
        document.addEventListener('touchmove', move, { passive: false });
        document.addEventListener('mouseup', stop);
        document.addEventListener('touchend', stop);
    }

    makeDrag(document.getElementById('edusoHeader'));
    makeDrag(dock);

    // --- Thu nhỏ / hiện lại ---
    const minBtn = document.getElementById('minBtn');

    minBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const rect = ui.getBoundingClientRect();
        dock.style.right = `${window.innerWidth - rect.right}px`;
        dock.style.top = `${rect.top}px`;
        dock.style.left = 'auto';
        dock.style.display = 'flex';
        ui.style.display = 'none';
    });

    dock.addEventListener('click', (e) => {
        e.stopPropagation();
        const rect = dock.getBoundingClientRect();
        ui.style.top = `${rect.top}px`;
        ui.style.right = `${window.innerWidth - rect.right}px`;
        ui.style.left = 'auto';
        ui.style.display = '';
        dock.style.display = 'none';
    });

    // --- Recorder logic (CẬP NHẬT) ---
    const countEl = document.getElementById('count');
    const copyBtn = document.getElementById('copyBtn');
    const saveBtn = document.getElementById('saveBtn');
    const statusEl = document.getElementById('status');
    let finalAnswers = [];

    function scanAllAnswers() {
        finalAnswers = [];

        // Quét các câu hỏi trắc nghiệm (trong form-group)
        const formGroups = document.querySelectorAll('.form-group.pl-3.m-0');

        formGroups.forEach(group => {
            const successSpans = group.querySelectorAll('span.text-success');
            if (successSpans.length === 0) return;

            const answers = [];
            successSpans.forEach(span => {
                let text = span.textContent.trim();
                if (!text || text.includes('Không có')) return;

                // Lấy chữ cái đầu tiên (A-Z)
                if (/^[A-Z][\.\)\s]/i.test(text)) {
                    answers.push(text.charAt(0).toUpperCase() + ".");
                }
            });

            if (answers.length > 0) {
                // Nếu 1 đáp án: string, nếu nhiều đáp án: array
                finalAnswers.push(answers.length === 1 ? answers[0] : answers);
            }
        });

        // Quét câu điền từ (fillquiz) - giữ logic cũ
        const fillQuizNodes = document.querySelectorAll('fillquiz i.text-success, fillquiz span.text-success');
        fillQuizNodes.forEach(el => {
            let text = el.textContent.trim();
            if (!text || text.includes('Không có')) return;
            if (text.includes('|')) text = text.split('|')[0].trim();
            finalAnswers.push(text);
        });

        countEl.textContent = finalAnswers.length;
    }

    function getResultString() { return JSON.stringify(finalAnswers, null, 2); }

    copyBtn.onclick = () => {
        scanAllAnswers();
        if (!finalAnswers.length) {
            statusEl.textContent = '⚠️ Không tìm thấy đáp án!';
            statusEl.style.color = '#ff66cc';
            return;
        }
        navigator.clipboard.writeText(getResultString())
            .then(() => {
                const oldText = copyBtn.innerHTML;
                copyBtn.innerHTML = `<svg width="14" height="14" style="vertical-align:-2px;margin-right:4px;" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"></polyline></svg>ĐÃ COPY!`;
                copyBtn.disabled = true;
                copyBtn.style.opacity = '0.8';
                setTimeout(() => {
                    copyBtn.innerHTML = oldText;
                    copyBtn.disabled = false;
                    copyBtn.style.opacity = '1';
                    statusEl.textContent = '✅ Đã sao chép vào clipboard';
                    statusEl.style.color = '#00ffea';
                }, 2000);
            })
            .catch(err => {
                statusEl.textContent = `❌ Lỗi clipboard: ${err.message}`;
                statusEl.style.color = '#ff66cc';
            });
    };

    saveBtn.onclick = () => {
        scanAllAnswers();
        if (!finalAnswers.length) {
            statusEl.textContent = '⚠️ Không tìm thấy đáp án!';
            statusEl.style.color = '#ff66cc';
            return;
        }
        const blob = new Blob([getResultString()], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `DAPAN_${new Date().toISOString().slice(0,10)}.json`;
        a.click();
        URL.revokeObjectURL(a.href);
        statusEl.textContent = '✅ Đã tải file đáp án';
        statusEl.style.color = '#00ffea';
    };

    // --- Auto scan ---
    setTimeout(scanAllAnswers, 1000);
    setInterval(scanAllAnswers, 2500);
})();
